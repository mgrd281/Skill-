---
// نافذة "رأيك": تظهر على يمين الشاشة بعد دقيقة من التصفح (src/scripts/feedback.js)، أو من رابط في التذييل.
// ثلاث مراحل: النجوم أولًا، ثم تنفتح الرسالة بعد اختيار التقييم، ثم رسالة الشكر.
// تُرسل إلى api/feedback.js. أيقوناتها مسجلة يدويًا في Base.astro لأنها تُرسم مع القالب.
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { type Lang, t as dict } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
---
<div class="fb" id="fb" role="dialog" aria-labelledby="fb-h" aria-describedby="fb-sub" hidden
  data-labels={JSON.stringify(t.fbLabels)} data-hint={t.fbHint} data-ph-low={t.fbPhLow} data-ph-high={t.fbPhHigh}>
  <button type="button" class="fb-x" id="fb-x" aria-label={t.fbClose} title={t.fbClose}><Icon name="x" weight="bold" /></button>
  <form class="fb-form" id="fb-form" novalidate>
    <div class="fb-top">
      <Logo size={36} />
      <div class="fb-tt">
        <h2 class="fb-h" id="fb-h">{t.fbTitle}</h2>
        <p class="fb-sub" id="fb-sub">{t.fbSub}</p>
      </div>
    </div>
    <fieldset class="fb-stars" id="fb-stars">
      <legend class="sr">{t.fbRate}</legend>
      {[1, 2, 3, 4, 5].map((n) => (
        <>
          <input type="radio" name="rating" value={n} id={"fb-r" + n} class="fb-r" />
          <label for={"fb-r" + n} data-n={n}>
            <Icon name="star" class="s-off" /><Icon name="star" weight="fill" class="s-on" /><span class="sr">{t.fbStar(n)} – {t.fbLabels[n - 1]}</span>
          </label>
        </>
      ))}
    </fieldset>
    <p class="fb-word" id="fb-word" aria-hidden="true">{t.fbHint}</p>
    <div class="fb-more" id="fb-more">
      <div class="fb-more-in">
        <label class="sr" for="fb-msg">{t.fbMsg}</label>
        <textarea id="fb-msg" name="message" rows="3" maxlength="1000" placeholder={t.fbMsgPh} tabindex="-1"></textarea>
        <input type="text" name="website" class="fb-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="fb-err" id="fb-err" role="alert" hidden></p>
        <button type="submit" class="fb-send" id="fb-send" tabindex="-1" disabled>{t.fbSend}</button>
        <small class="fb-note">{t.fbPrivacy}</small>
      </div>
    </div>
  </form>
  <div class="fb-done" id="fb-done" hidden>
    <svg class="fb-check" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="24" /><path d="M15 27.5l7 7 15-16" /></svg>
    <p class="fb-done-h">{t.fbThanks}</p>
    <p class="fb-done-sub">{t.fbThanksSub}</p>
  </div>
</div>
