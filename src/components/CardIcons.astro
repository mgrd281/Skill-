---
// أيقونات بطاقة الأداة كلها داخل <template>: الصفحة التي تضيف بطاقات لاحقًا (src/scripts/cards.js) لا ترسمها وقت البناء،
// فتُذكر هنا حتى تدخل رسم الصفحة (IconSprite). scripts/check-icons.mjs يتحقق أن كل أيقونة في البطاقات موجودة.
import Icon from "./Icon.astro";
import { tools, kindIcon } from "../lib/data";
import { type Lang, fwdIcon } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const kinds = [...new Set(tools.map((x) => kindIcon(x.kind)))];
---
<template id="card-icons">
  {kinds.map((k) => <Icon name={k} />)}
  <Icon name="star" weight="fill" /><Icon name="seal-check" weight="fill" /><Icon name="clock" /><Icon name="heart" /><Icon name="heart" weight="fill" /><Icon name="eye-slash" />
  <Icon name="copy" /><Icon name="check" weight="bold" /><Icon name="github-logo" /><Icon name="globe" /><Icon name={fwdIcon(lang)} />
</template>
