---
import Icon from "./Icon.astro";
import { type Tool, projectById, rich, isLatin, repoLabel, host, isAppStore, url, statusBadges, formatDate, initials, kindIcon } from "../lib/data";
interface Props { tool: Tool; linkName?: boolean; hideBtn?: boolean; favBtn?: boolean; rank?: number }
const { tool: t, linkName = true, hideBtn = false, favBtn = true, rank } = Astro.props;
const search = [
  t.name, t.desc, t.kind, t.cmd || "",
  ...t.use.map((u) => projectById(u)?.name ?? ""),
].join(" ").toLowerCase();
// أول ثلاثة مشاريع ظاهرة، والباقي خلف زر "+N"
const SHOW = 3;
const extra = t.use.slice(SHOW).map((u) => projectById(u)?.name ?? "").join("، ");
const date = formatDate(t.added.slice(0, 10));
---
<article
  class="card"
  id={"t-" + t.slug}
  data-slug={t.slug}
  data-cat={t.cat}
  data-new={t.isNew ? "1" : "0"}
  data-kind={t.kind}
  data-use={t.use.join(" ")}
  data-stars={t.starsN}
  data-order={t.order}
  data-added={t.added}
  data-search={search}
>
  <div class="c-head">
    <span class="mono" aria-hidden="true">{initials(t.name)}</span>
    <div class="c-id">
      <div class="c-title">
        <span class="rank" hidden={!rank} data-top={rank && rank <= 3 ? String(rank) : ""}>{rank ? "#" + rank : ""}</span>
        {linkName ? <a class="name" href={url("tools/" + t.slug)}>{t.name}</a> : <span class="name">{t.name}</span>}
      </div>
      <div class="c-meta">
        <span class="kind"><Icon name={kindIcon(t.kind)} />{isLatin(t.kind) ? <bdi>{t.kind}</bdi> : t.kind}</span>
        {t.stars && (
          <span class="stars" title="نجوم GitHub"><Icon name="star" filled />{t.stars}</span>
        )}
        <time class="addedchip" datetime={t.added} data-added={t.added} title={"أُضيفت إلى الدليل: " + date}>
          <Icon name="clock" /><span class="added-text">{date}</span>
        </time>
      </div>
    </div>
    <div class="c-act">
      {favBtn && (
        <button type="button" class="fav" data-fav={t.slug} data-name={t.name} aria-pressed="false" aria-label={`أضف ${t.name} إلى المفضلة`} title="أضف إلى المفضلة">
          <Icon name="heart" />
        </button>
      )}
      {hideBtn && (
        <button type="button" class="hide" data-hide={t.slug} aria-label={`إخفاء ${t.name} من عرضك`} title="إخفاء من عرضك (يمكن استعادتها)">
          <Icon name="eye-off" />
        </button>
      )}
    </div>
  </div>

  <div class="tags">
    <span class="badge-pick" hidden>ابدأ بها</span>
    {t.isNew && <span class="badge-new">جديد</span>}
    {statusBadges(t).map((b) => (
      <span class={b.kind === "ok" ? "tag" : `tag tag-${b.kind}`} title={b.title}>{b.text}{b.text && b.latin ? " " : ""}{b.latin && <bdi>{b.latin}</bdi>}</span>
    ))}
  </div>

  <p class="desc" set:html={rich(t.desc)} />

  <div class="uses">
    <span class="l">مفيد لـ</span>
    {t.use.map((u, i) => (
      <button type="button" class={i < SHOW ? "usechip" : "usechip more"} data-p={u} set:html={rich(projectById(u)!.name)} />
    ))}
    {t.use.length > SHOW && (
      <button type="button" class="usemore" aria-expanded="false" title={extra}>+{t.use.length - SHOW}</button>
    )}
  </div>

  <div class="bottom">
    {t.cmd && (
      <div class="cmd">
        <pre tabindex="0" aria-label="أمر التثبيت"><code>{t.cmd}</code></pre>
        <button type="button" class="copy" aria-label="نسخ أمر التثبيت">
          <Icon name="copy" class="ic-copy" /><Icon name="check" class="ic-check" /><span class="copy-t">نسخ</span>
        </button>
      </div>
    )}
    {(t.gh || t.site) && (
      <div class="links">
        {t.gh && (
          <a class="lnk" href={t.gh} target="_blank" rel="noopener noreferrer" aria-label={`GitHub: ${t.name}`} title={repoLabel(t.gh)}>
            <Icon name="github" /><bdi>GitHub</bdi><Icon name="chevron" class="chev" />
          </a>
        )}
        {t.site && (
          <a class="lnk" href={t.site} target="_blank" rel="noopener noreferrer" aria-label={`${isAppStore(t.site) ? "App Store" : "الموقع الرسمي"}: ${t.name}`} title={host(t.site)}>
            <Icon name="globe" />{isAppStore(t.site) ? "App Store" : "الموقع الرسمي"}<Icon name="chevron" class="chev" />
          </a>
        )}
      </div>
    )}
  </div>
</article>
