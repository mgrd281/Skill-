---
import Icon from "./Icon.astro";
import { type Tool, projectById, txt, isLatin, repoLabel, host, isAppStore, statusBadges, formatDate, initials, appIcon, pickFor, kindIcon, kindLabel, toolDesc, projName } from "../lib/data";
import { type Lang, DEFAULT_LANG, href, fwdIcon, t as dict } from "../i18n";
interface Props { tool: Tool; linkName?: boolean; hideBtn?: boolean; favBtn?: boolean; rank?: number; lang?: Lang }
const { tool: t, linkName = true, hideBtn = false, favBtn = true, rank, lang = DEFAULT_LANG } = Astro.props;
const s = dict(lang);
const desc = toolDesc(t, lang);
const kind = kindLabel(t.kind, lang);
const useName = (u: string) => projName(projectById(u)!, lang);
// أول ثلاثة مشاريع ظاهرة، والباقي خلف زر "+N"
const SHOW = 3;
const extra = t.use.slice(SHOW).map(useName).join(s.listSep);
const date = formatDate(t.added.slice(0, 10), lang);
const rec = pickFor(t.slug, lang);
const site = t.site && (isAppStore(t.site) ? "App Store" : s.officialSite);
---
<article
  class="card"
  id={"t-" + t.slug}
  data-slug={t.slug}
  data-cat={t.cat}
  data-new={t.isNew ? "1" : "0"}
  data-kind={t.kind}
  data-use={t.use.join(" ")}
  data-stars={t.starsN}
  data-order={t.order}
  data-added={t.added}
>
  <div class="c-head">
    {appIcon(t.slug) ? <span class="mono has-img" aria-hidden="true"><img src={appIcon(t.slug)} alt="" width="48" height="48" loading="lazy" decoding="async" /></span> : <span class="mono" aria-hidden="true">{initials(t.name)}</span>}
    <div class="c-id">
      <div class="c-title">
        <span class="rank" hidden={!rank} data-top={rank && rank <= 3 ? String(rank) : ""}>{rank ? "#" + rank : ""}</span>
        {linkName ? <a class="name" href={href(lang, "tools/" + t.slug)}>{t.name}</a> : <span class="name">{t.name}</span>}
      </div>
      <div class="c-meta">
        <span class="kind"><Icon name={kindIcon(t.kind)} />{isLatin(kind) ? <bdi>{kind}</bdi> : kind}</span>
        {t.stars && (
          <span class="stars" title={s.ghStars}><Icon name="star" weight="fill" />{t.stars}</span>
        )}
        <time class="addedchip" datetime={t.added} data-added={t.added} title={s.addedOn + date}>
          <Icon name="clock" /><span class="added-text">{date}</span>
        </time>
      </div>
    </div>
    <div class="c-act">
      {favBtn && (
        <button type="button" class="fav" data-fav={t.slug} data-name={t.name} aria-pressed="false" aria-label={s.favAdd(t.name)} title={s.favAddTitle}>
          <Icon name="heart" class="h-off" /><Icon name="heart" weight="fill" class="h-on" />
        </button>
      )}
      {hideBtn && (
        <button type="button" class="hide" data-hide={t.slug} aria-label={s.hide(t.name)} title={s.hideTitle}>
          <Icon name="eye-slash" />
        </button>
      )}
    </div>
  </div>

  <div class="tags">
    <span class="badge-pick" hidden>{s.pick}</span>
    {rec && <span class="badge-rec"><Icon name="seal-check" weight="fill" />{s.recFor(rec)}</span>}
    {t.isNew && <span class="badge-new">{s.isNew}</span>}
    {statusBadges(t, lang).map((b) => (
      <span class={b.kind === "ok" ? "tag" : `tag tag-${b.kind}`} title={b.title}>{b.text}{b.text && b.latin ? " " : ""}{b.latin && <bdi>{b.latin}</bdi>}</span>
    ))}
  </div>

  <p class="desc" set:html={txt(desc, lang)} />

  {t.use.length > 0 && (
    <div class="uses">
      <span class="l">{s.usefulFor}</span>
      {t.use.map((u, i) => (
        <button type="button" class={i < SHOW ? "usechip" : "usechip more"} data-p={u} set:html={txt(useName(u), lang)} />
      ))}
      {t.use.length > SHOW && (
        <button type="button" class="usemore" aria-expanded="false" title={extra}>+{t.use.length - SHOW}</button>
      )}
    </div>
  )}

  <div class="bottom">
    {t.cmd && (
      <div class="cmd">
        <pre tabindex="0" aria-label={s.cmdAria}><code>{t.cmd}</code></pre>
        <button type="button" class="copy" aria-label={s.copyAria}>
          <Icon name="copy" class="ic-copy" /><Icon name="check" weight="bold" class="ic-check" /><span class="copy-t">{s.copy}</span>
        </button>
      </div>
    )}
    {(t.gh || t.site) && (
      <div class="links">
        {t.gh && (
          <a class="lnk" href={t.gh} target="_blank" rel="noopener noreferrer" aria-label={`GitHub: ${t.name}`} title={repoLabel(t.gh)}>
            <Icon name="github-logo" /><bdi>GitHub</bdi><Icon name={fwdIcon(lang)} class="chev" />
          </a>
        )}
        {t.site && (
          <a class="lnk" href={t.site} target="_blank" rel="noopener noreferrer" aria-label={`${site}: ${t.name}`} title={host(t.site)}>
            <Icon name="globe" />{site}<Icon name={fwdIcon(lang)} class="chev" />
          </a>
        )}
      </div>
    )}
  </div>
</article>
