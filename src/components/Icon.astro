---
// مجموعة الأيقونات الوحيدة في الموقع: Phosphor (رخصة MIT)، مولَّدة في src/lib/icons.ts بـ `npm run icons`.
// الأسماء كما في https://phosphoricons.com. اللون currentColor والحجم من CSS (.i) أو من size.
// الأوزان: regular للواجهة، duotone للبلاطات الكبيرة، fill للحالة المفعّلة، bold لعلامات التأكيد الصغيرة.
// الأيقونة لا تُكرَّر في الصفحة: تُرسم مرة واحدة في <IconSprite> (داخل Base) ويُشار إليها هنا بـ <use>.
import { ICONS, type IconName, type IconWeight } from "../lib/icons";
import { useIcon } from "../lib/icon-sprite";
interface Props { name: IconName; weight?: IconWeight; size?: number; class?: string }
const { name, weight = "regular", size, class: cls = "" } = Astro.props;
if (!ICONS[name]?.[weight]) throw new Error(`الأيقونة "${name}" بوزن "${weight}" غير مولَّدة. أضفها في scripts/build-icons.mjs`);
const id = useIcon(Astro.locals, name, weight);
---
<svg class={`i ${cls}`.trim()} width={size} height={size} aria-hidden="true"><use href={`#${id}`} /></svg>
