---
// شعار الدليل: ثلاث بطاقات أدوات ونجمة ذهبية لامعة للمهارات. الرسم في src/lib/brand.js (مصدر واحد للواجهة وصور المشاركة والأيقونات).
// فئة spark للنجمة: تتحرك في global.css (دخول الشريط العلوي، والدوران عند المرور).
import { markInner } from "../lib/brand.js";
interface Props { size?: number }
const { size = 32 } = Astro.props;
---
<svg class="logo" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" set:html={markInner()} />
