---
// شعار الدليل: وجه شخصية الدليل (بلاطة زرقاء بعينين وابتسامة) ونجمة ذهبية لامعة. الرسم في src/lib/brand.js (مصدر واحد للواجهة وصور المشاركة والأيقونات).
// فئة spark للنجمة وeyes للعينين: تتحركان في global.css (دخول الشريط العلوي، والدوران والرمش عند المرور).
import { markInner } from "../lib/brand.js";
interface Props { size?: number }
const { size = 32 } = Astro.props;
---
<svg class="logo" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" set:html={markInner()} />
