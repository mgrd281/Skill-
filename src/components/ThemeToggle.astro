---
import Icon from "./Icon.astro";
// زر الوضع الداكن/الفاتح. الاختيار يُحفظ في المتصفح، وبدونه يتبع الموقع إعداد الجهاز.
---
<button type="button" class="bell themetoggle" data-theme-toggle aria-label="تبديل الوضع الداكن" title="الوضع الداكن / الفاتح">
  <Icon name="moon" class="i-moon" />
  <Icon name="sun" class="i-sun" />
</button>
<script>
  const KEY = "toolkit-theme";
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  function sync() {
    document.querySelectorAll("[data-theme-toggle]").forEach((b) => {
      b.setAttribute("aria-pressed", isDark() ? "true" : "false");
    });
  }
  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element) || !e.target.closest("[data-theme-toggle]")) return;
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem(KEY, next); } catch (err) {}
    sync();
  });
  sync();
</script>
