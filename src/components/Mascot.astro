---
// شخصية الدليل: بلاطة الشعار الزرقاء بعينين وحاجبين وخد ذهبي، والنجمة الذهبية فوق رأسها كفكرة لامعة.
// ألوانها ثابتة في الوضعين مثل الشعار، بلا تدرج ولا ظل. زينة فقط (aria-hidden).
// الحركة (global.css، قسم "الشخصية"): تمشي إلى مكانها عند فتح الصفحة ثم تقف وترمش، والنجمة تلمع.
// src/scripts/mascot.js يجعل عينيها تتابعان المؤشر وتقفز عند لمسها. مع تقليل الحركة تظهر واقفة بلا حركة.
// في العربية تُعكس أفقيًا فتمشي من اليمين إلى اليسار مثل اتجاه القراءة.
// pose="lost" لصفحة 404: حاجبان قلقان وفم مفتوح، وتتلفت مرة واحدة بدل المشي.
import { COLORS } from "../lib/brand.js";
interface Props { pose?: "happy" | "lost" }
const { pose = "happy" } = Astro.props;
const lost = pose === "lost";
const INK = "#1D1D1F";
const S = 2.6; // سُمك الخطوط
// الساقان: فخذ مستدير وحذاء مقدمته إلى الأمام. hx مركز الورك
const leg = (hx: number, cls: string) => `<g class="m-leg ${cls}">
  <rect x="${hx - 5.5}" y="96" width="11" height="24" rx="5.5" fill="#fff" stroke="${INK}" stroke-width="${S}"/>
  <path d="M${hx - 7} 128.5V124Q${hx - 7} 119.5 ${hx - 2.5} 119.5H${hx + 4}Q${hx + 12.5} 119.5 ${hx + 12.5} 126V128.5Z" fill="#fff" stroke="${INK}" stroke-width="${S}" stroke-linejoin="round"/>
</g>`;
// نجمة الشعار بنسبها (منحنيات تربيعية بأربعة أذرع)
const spark = (cx: number, cy: number, r: number, k = r * 0.125) =>
  `M${cx} ${cy - r}Q${cx + k} ${cy - k} ${cx + r} ${cy}Q${cx + k} ${cy + k} ${cx} ${cy + r}Q${cx - k} ${cy + k} ${cx - r} ${cy}Q${cx - k} ${cy - k} ${cx} ${cy - r}Z`;
const svg = `
<g class="m-bob">
  ${leg(50, "m-leg-b")}${leg(80, "m-leg-f")}
  <g transform="rotate(-4 66 63)">
    <rect x="7" y="59" width="20" height="11" rx="5.5" fill="${COLORS.blue}" transform="rotate(28 17 64.5)"/>
    <g class="m-arm"><rect x="105" y="57" width="20" height="11" rx="5.5" fill="${COLORS.blue}" transform="rotate(-28 115 62.5)"/></g>
    <rect x="20" y="20" width="92" height="86" rx="27" fill="${COLORS.blue}"/>
    <g fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" class="m-brows">
      ${lost ? `<path d="M40 41Q50 40 57 34"/><path d="M73 34Q80 40 90 41"/>` : `<path d="M40 40Q49 35 58 39"/><path d="M72 39Q81 35 90 40"/>`}
    </g>
    <g class="m-eyes">
      <ellipse cx="50" cy="58" rx="11" ry="13" fill="#fff"/><ellipse cx="80" cy="58" rx="11" ry="13" fill="#fff"/>
      <g class="m-pupils">
        <circle cx="50" cy="59.5" r="5.6" fill="${INK}"/><circle cx="80" cy="59.5" r="5.6" fill="${INK}"/>
        <circle cx="52" cy="57" r="1.7" fill="#fff"/><circle cx="82" cy="57" r="1.7" fill="#fff"/>
      </g>
    </g>
    <circle cx="35" cy="81" r="6.5" fill="${COLORS.gold}"/>
    ${lost ? `<ellipse cx="66" cy="86" rx="4.5" ry="5.5" fill="#fff"/>` : `<path d="M58 83Q66 90 74 82" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round"/>`}
  </g>
  <path class="m-spark" d="${spark(104, 19, 13)}" fill="${COLORS.gold}"/>
</g>`;
---
<div class={lost ? "mascot lost" : "mascot"} data-mascot aria-hidden="true">
  <svg class="m-svg" viewBox="0 0 132 132" set:html={svg} />
</div>
