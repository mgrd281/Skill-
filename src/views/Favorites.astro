---
// صفحة المفضلة بلغة معينة. تُبنى من src/pages/favorites.astro وsrc/pages/de/favorites.astro.
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import { tools } from "../lib/data";
import { type Lang, href, t as dict } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
---
<Base title={t.favTitle} description={t.favDesc} path="/favorites" noindex lang={lang}>
  <header class="top page-hero">
    <h1>{t.favH1}</h1>
    <p class="lead" id="fav-lead">{t.favLead}</p>
  </header>

  <div class="favtools" hidden>
    <p class="status" id="fav-status" aria-live="polite"></p>
    <button type="button" class="linkbtn" id="fav-clear">{t.favClear}</button>
  </div>

  <main class="band alt" id="fav-main">
    <div class="grid" id="fav-grid"></div>
    <div class="favempty" id="fav-empty" hidden>
      <span class="empty-ic heart"><Icon name="heart" weight="duotone" /></span>
      <p>{t.favEmpty}</p>
      <p class="sub">{t.favEmptySub}</p>
      <a class="btn-primary" href={href(lang)}>{t.browse}</a>
    </div>
  </main>

  <!-- كل البطاقات هنا مخفية، والسكربت ينقل المفضلة منها إلى الشبكة أعلاه -->
  <div id="pool" hidden>
    {tools.map((x) => <Card tool={x} lang={lang} />)}
  </div>

  <Fragment slot="footer">
    <p>{t.favFoot}</p>
  </Fragment>
</Base>

<script>
  import { initCopy } from "../scripts/copy.js";
  import { initFav, getFavs, onFavChange, clearFavs } from "../scripts/fav.js";
  import { initDates } from "../scripts/dates.js";
  import { L, fmt } from "../i18n/client.js";

  const grid = document.getElementById("fav-grid");
  const pool = document.getElementById("pool");
  const empty = document.getElementById("fav-empty");
  const bar = document.querySelector(".favtools");
  const status = document.getElementById("fav-status");

  function render() {
    const favs = getFavs();
    const want = new Set(favs);
    // أعد البطاقات التي لم تعد مفضلة إلى المخزن
    [...grid.children].forEach((c) => { if (!want.has(c.dataset.slug)) pool.appendChild(c); });
    // رتّب المفضلة: الأحدث أولًا
    favs.forEach((slug) => {
      const card = document.getElementById("t-" + slug) || pool.querySelector('[data-slug="' + slug + '"]');
      if (card) grid.appendChild(card);
    });
    const n = grid.children.length;
    empty.hidden = n !== 0;
    bar.hidden = n === 0;
    status.textContent = fmt(L.favCount, { n });
  }

  initCopy(document);
  initFav();
  initDates();
  render();
  onFavChange(render);
  document.getElementById("fav-clear").addEventListener("click", () => {
    if (confirm(L.favConfirm)) clearFavs();
  });
</script>
