---
// صفحة المفضلة بلغة معينة. تُبنى من src/pages/favorites.astro ونظيريها في src/pages/de/ وsrc/pages/en/.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CardIcons from "../components/CardIcons.astro";
import { tools } from "../lib/data";
import { type Lang, href, t as dict } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
---
<Base title={t.favTitle} description={t.favDesc} path="/favorites" noindex lang={lang}>
  <header class="top page-hero">
    <h1 id="fav-h">{t.favH1}</h1>
    <p class="lead" id="fav-lead">{t.favLead}</p>
  </header>

  <!-- قائمة مشاركة (?list=a,b,c): يراها من فتح الرابط، ويضيفها إلى مفضلته إن شاء -->
  <div class="shared-bar" id="shared-bar" hidden>
    <p class="status" id="shared-status"></p>
    <div class="favacts">
      <button type="button" class="btn-primary" id="shared-add">{t.sharedAdd}</button>
      <button type="button" class="kit-btn" id="shared-kit" data-kit="" data-kit-title={t.kitTitle}><Icon name="terminal-window" />{t.kitBtn}</button>
      <a class="linkbtn" id="shared-mine" href={href(lang, "favorites/")}>{t.sharedMine}</a>
    </div>
  </div>

  <div class="favtools" hidden>
    <p class="status" id="fav-status" aria-live="polite"></p>
    <div class="favacts">
      <button type="button" class="kit-btn" id="fav-kit" data-kit="" data-kit-title={t.kitFavs}><Icon name="terminal-window" />{t.kitBtn}</button>
      <a class="kit-btn" id="fav-cmp" href={href(lang, "compare/")} hidden><Icon name="scales" />{t.compare}</a>
      <button type="button" class="kit-btn" id="fav-share"><Icon name="export" />{t.favShare}</button>
      <button type="button" class="linkbtn" id="fav-clear">{t.favClear}</button>
    </div>
  </div>

  <main class="band alt" id="fav-main">
    <p class="status fav-loading" id="fav-loading" aria-live="polite" hidden></p>
    <div class="grid" id="fav-grid"></div>
    <div class="favempty" id="fav-empty" hidden>
      <span class="empty-ic heart"><Icon name="heart" weight="duotone" /></span>
      <p>{t.favEmpty}</p>
      <p class="sub">{t.favEmptySub}</p>
      <a class="btn-primary" href={href(lang)}>{t.browse}</a>
    </div>
  </main>

  <CardIcons lang={lang} />
  <!-- أسماء الأدوات المختصرة فقط: البطاقات تُجلب من /cards/ ويُعرض منها ما في المفضلة (src/scripts/cards.js) -->
  <script type="application/json" id="fav-slugs" set:html={JSON.stringify(tools.map((x) => x.slug))} />

  <Fragment slot="footer">
    <p>{t.favFoot}</p>
  </Fragment>
</Base>

<script>
  import { initCopy } from "../scripts/copy.js";
  import { initFav, getFavs, onFavChange, clearFavs, addFavs, syncFavButtons } from "../scripts/fav.js";
  import { loadCards, makeCard } from "../scripts/cards.js";
  import { toast } from "../scripts/ui.js";
  import { L, fmt } from "../i18n/client.js";

  const grid = document.getElementById("fav-grid");
  const loading = document.getElementById("fav-loading");
  const empty = document.getElementById("fav-empty");
  const bar = document.querySelector(".favtools");
  const status = document.getElementById("fav-status");

  // قائمة مشاركة في الرابط: الأدوات الموجودة فقط، بلا تكرار، 60 بحد أقصى
  const slugs = new Set(JSON.parse(document.getElementById("fav-slugs").textContent));
  const known = (s) => slugs.has(s);
  const shared = [...new Set((new URLSearchParams(location.search).get("list") || "").split(",").map((s) => s.trim()).filter(Boolean))].filter(known).slice(0, 60);
  const sharedMode = shared.length > 0;
  const list = () => (sharedMode ? shared : getFavs());

  // بطاقات المفضلة: تُنشأ من البطاقات المجلوبة عند أول حاجة، بلا زر «إخفاء» ولا رقم ترتيب (خاصان بالرئيسية)
  let state = "loading";
  const made = new Map();
  function cardOf(slug) {
    let el = made.get(slug);
    if (el) { syncFavButtons(el); return el; }
    el = makeCard(slug);
    if (!el) return null;
    el.querySelector(".hide")?.remove();
    el.querySelector(".rank")?.setAttribute("hidden", "");
    made.set(slug, el);
    return el;
  }

  function render() {
    const favs = list().filter(known);
    const want = new Set(favs);
    const n = favs.length;
    // حتى تصل البطاقات: «جارٍ التحميل» مكانها، والأزرار والعدد جاهزة
    loading.hidden = state === "ready" || n === 0;
    loading.textContent = state === "error" ? L.loadError : L.loading;
    if (state === "ready") {
      // التي لم تعد مفضلة تخرج، والمفضلة بترتيبها (الأحدث أولًا)، ولا تُحرَّك بطاقة في مكانها (يبقى التركيز)
      [...grid.children].forEach((c) => { if (!want.has(c.dataset.slug)) c.remove(); });
      let ref = grid.firstElementChild;
      favs.forEach((slug) => {
        const card = cardOf(slug);
        if (!card) return;
        if (card === ref) { ref = ref.nextElementSibling; return; }
        grid.insertBefore(card, ref);
      });
    }
    empty.hidden = n !== 0;
    bar.hidden = n === 0 || sharedMode;
    status.textContent = fmt(L.favCount, { n });
    if (sharedMode) {
      document.getElementById("shared-kit").dataset.kit = shared.join(" ");
      const mine = new Set(getFavs());
      const left = shared.filter((s) => !mine.has(s)).length;
      document.getElementById("shared-status").textContent = fmt(L.sharedN, { n });
      document.getElementById("shared-add").hidden = left === 0;
    }
    // حزمة التثبيت للمفضلة بترتيبها (src/scripts/kit.js)
    document.getElementById("fav-kit").dataset.kit = favs.join(" ");
    // المقارنة: أحدث ثلاث في المفضلة
    const cmp = document.getElementById("fav-cmp");
    cmp.hidden = favs.length < 2;
    cmp.href = cmp.href.split("?")[0] + "?t=" + favs.slice(0, 3).join(",");
  }

  initCopy(document);
  initFav();
  if (sharedMode) {
    document.getElementById("fav-h").textContent = L.sharedTitle;
    document.getElementById("fav-lead").textContent = L.sharedLead;
    document.getElementById("shared-bar").hidden = false;
    document.getElementById("shared-add").addEventListener("click", () => {
      const n = addFavs(shared);
      toast(fmt(L.sharedAdded, { n }));
    });
  }
  render();
  onFavChange(render);
  loadCards().then(() => { state = "ready"; render(); }, () => { state = "error"; render(); });
  // مشاركة المفضلة رابطًا: قائمة المشاركة في الجوال، ونسخ الرابط على الحاسوب
  document.getElementById("fav-share").addEventListener("click", () => {
    const url = location.origin + location.pathname + "?list=" + getFavs().slice(0, 60).join(",");
    if (navigator.share) navigator.share({ title: document.title, url }).catch(() => {});
    else navigator.clipboard?.writeText(url).then(() => toast(L.favShareCopied), () => {});
  });
  document.getElementById("fav-clear").addEventListener("click", () => {
    if (confirm(L.favConfirm)) clearFavs();
  });
</script>
