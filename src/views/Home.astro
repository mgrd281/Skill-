---
// الصفحة الرئيسية بلغة معينة. تُبنى من src/pages/index.astro (العربية) وsrc/pages/de/index.astro (الألمانية) وsrc/pages/en/index.astro (الإنجليزية).
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import Odometer from "../components/Odometer.astro";
import Mascot from "../components/Mascot.astro";
import CardIcons from "../components/CardIcons.astro";
import Newsletter from "../components/Newsletter.astro";
import { tools, byStars, rankOf, categories, projects, starsUpdatedAt, formatDate, recentTools, initials, kindIcon, kindLabel, categoryIcon, projectIcon, txt, catName, projName, projAdvice } from "../lib/data";
import { type Lang, href, fwdIcon, t as dict } from "../i18n";
import { kitPlan } from "../lib/install.js";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const fwd = fwdIcon(lang);

const total = tools.length;
// أول القائمة فقط مرسوم في الصفحة (بعدد PAGE في src/scripts/filter.js)، والباقي يُجلب عند الحاجة من /cards/
// (src/views/CardsFragment.astro): 268 بطاقة دفعة واحدة كانت تجمّد الصفحة ثوانيَ على الجوال
const FIRST = 12;
const latest = recentTools.slice(0, 6);
// المعرض المتحرك: أعلى ثلاث أدوات، ومع كل منها أول سطر من أمر تثبيتها (--n عدد خطوات الكتابة)
const showcase = byStars.slice(0, 3).map((x) => ({ ...x, line: x.cmd ? x.cmd.split("\n")[0] : "" }));
const skillCount = tools.filter((x) => x.kind === "Skill").length;
const siteCount = tools.filter((x) => x.kind === "موقع").length;
const appData = {
  total,
  projects: projects.map((p) => ({ id: p.id, name: projName(p, lang), cats: p.cats ?? [], pickSlugs: p.pickSlugs })),
  cats: categories.map((c) => c.id),
  base: href(lang, "tools/"),
  feed: href(lang, "feed.xml"),
  recent: recentTools.map((r) => ({ slug: r.slug, name: r.name, added: r.added, cat: catName(r.cat, lang) })),
  // ما تحتاجه الفلترة والترتيب والعدّ لكل أداة، بترتيب النجوم: s الاسم المختصر، nm الاسم، c القسم، k مهارة، n جديدة،
  // st النجوم، o ترتيب الإضافة، a تاريخها، u المشاريع
  tools: byStars.map((x) => ({ s: x.slug, nm: x.name, c: x.cat, k: x.kind === "Skill" ? 1 : 0, n: x.isNew ? 1 : 0, st: x.starsN, o: x.order, a: x.added, u: x.use.join(" ") })),
  // أسماء الأقسام لقسم «الأكثر نسخًا» (src/scripts/popular.js)
  catNames: Object.fromEntries(categories.map((c) => [c.id, catName(c.id, lang)])),
};
// بيانات منظمة: اسم الموقع وأعلى الأدوات نجومًا
const abs = (p: string) => new URL(href(lang, p), Astro.site).href;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: t.siteName, alternateName: t.siteTitle, url: abs(""), inLanguage: lang, description: t.homeDesc(total) },
  {
    "@context": "https://schema.org", "@type": "ItemList", name: t.allTools,
    itemListElement: byStars.slice(0, 10).map((x, i) => ({ "@type": "ListItem", position: i + 1, name: x.name, url: abs("tools/" + x.slug) })),
  },
];
// زر «حزمة التثبيت» لمشروع فقط إن دخلت الحزمةَ أداتان من أدوات «ابدأ بهذه» على الأقل (src/lib/install.js)
const kitCount = (slugs: string[]) => slugs.filter((s) => { const x = tools.find((t) => t.slug === s); return x && kitPlan(x).lines; }).length;
const kinds: Array<[string, any, string]> = [
  ["Skill", "sparkle", t.legendSkill_h],
  ["MCP", "plug", t.legendMcp_h],
];
---
<Base title={t.siteTitle} description={t.homeDesc(total)} lang={lang} jsonLd={jsonLd} quickSearch={false}>
  <div class="notif-wrap" slot="nav-extra">
    <button type="button" id="bell" class="bell" aria-haspopup="dialog" aria-expanded="false" aria-controls="notif" aria-label={t.bellAria}>
      <Icon name="bell" />
      <span class="dot" id="bell-n" hidden>0</span>
    </button>
    <div class="notif" id="notif" role="dialog" aria-labelledby="nf-h" hidden>
      <div class="nf-head">
        <h3 id="nf-h">{t.notifTitle}</h3>
        <button type="button" class="linkbtn" id="notif-read">{t.notifRead}</button>
      </div>
      <ul class="nf-list" id="notif-list"></ul>
      <div class="nf-empty" id="notif-empty">
        <span class="empty-ic"><Icon name="bell" weight="duotone" /></span>
        <p>{t.notifEmpty}</p>
      </div>
      <a class="nf-foot" href={href(lang, "feed.xml")}><Icon name="rss-simple" /><span set:html={t.notifRss_h} /><Icon name={fwd} class="chev" /></a>
    </div>
  </div>

  <header class="hero">
    <div class="hero-text">
      <Mascot />
      <p class="eyebrow" style="--i:0">{t.siteName}</p>
      <h1 style="--i:1" set:html={t.heroH1_h} />
      <p class="lead" style="--i:2" set:html={t.heroLead_h} />
      <div class="cta" style="--i:3">
        <button type="button" class="hero-search" data-focus-search>
          <Icon name="magnifying-glass" /><span class="hs-t" set:html={t.heroSearch_h} /><kbd aria-hidden="true">/</kbd>
        </button>
        <a class="link-more" href="#build-h">{t.navBuild}<Icon name={fwd} /></a>
        <button type="button" class="link-more" data-finder aria-haspopup="dialog">{t.fdOpen}<Icon name={fwd} /></button>
      </div>
      <p class="tries" style="--i:3">
        <span class="l">{t.heroTry}</span>
        {t.heroTries.map((q) => <a class="try" href={"?q=" + encodeURIComponent(q) + "#list"} data-q={q} dir="auto">{q}</a>)}
      </p>
      <ul class="promise" style="--i:4">
        <li><Icon name="magnifying-glass" weight="duotone" />{t.promiseSearch}</li>
        <li><Icon name="squares-four" weight="duotone" />{t.promiseOne}</li>
        <li><Icon name="copy" weight="duotone" />{t.promiseCmd}</li>
      </ul>
    </div>

    <!-- معرض متحرك: أعلى ثلاث أدوات تتبادل الواجهة، ومع كل بطاقة يُكتب أمر تثبيتها ثم يُنسخ (src/scripts/hero.js).
         data-pos: الواجهة 0، والتالية 1، والسابقة 2. بلا سكربت أو مع تقليل الحركة يبقى المعرض ثابتًا. -->
    <div class="showcase" aria-hidden="true" data-deck>
      {showcase.map((x, i) => (
        <a class="deck-card" data-pos={i} href={href(lang, "tools/" + x.slug)} tabindex="-1">
          <span class="show-card">
            <span class="show-head">
              <span class="mono">{initials(x.name)}</span>
              <span class="show-t">
                <span class="show-name"><span class="rank" data-top={i + 1}>#{i + 1}</span><b>{x.name}</b></span>
                <small set:html={txt(catName(x.cat, lang), lang)} />
              </span>
              {x.stars && <span class="stars"><Icon name="star" weight="fill" />{x.stars}</span>}
            </span>
            {x.line && (
              <span class="show-cmd">
                <span class="show-ps">$</span>
                <code style={`--n:${Math.min(x.line.length, 36)}`}>{x.line}</code>
                <span class="show-copy"><Icon name="copy" class="ic-copy" /><Icon name="check" weight="bold" class="ic-check" /></span>
              </span>
            )}
          </span>
        </a>
      ))}
    </div>

    <dl class="stats">
      <div><dt>{t.statTools}</dt><dd><Odometer n={total} /></dd></div>
      <div><dt set:html={t.statSkills_h} /><dd><Odometer n={skillCount} /></dd></div>
      <div><dt>{t.statSites}</dt><dd><Odometer n={siteCount} /></dd></div>
      <div><dt>{t.statCats}</dt><dd><Odometer n={categories.length} /></dd></div>
    </dl>
  </header>

  <div class="bar">
    <div class="bar-row">
      <div class="search">
        <Icon name="magnifying-glass" />
        <input id="q" type="search" placeholder={t.searchPh} autocomplete="off" aria-label={t.searchAria} enterkeyhint="search" />
        <button type="button" class="q-clear" id="q-clear" aria-label={t.searchClear} hidden><Icon name="x" weight="bold" /></button>
        <kbd class="q-kbd" aria-hidden="true">/</kbd>
      </div>
      <button type="button" class="cat-btn" id="cat-btn" aria-haspopup="dialog" aria-expanded="false" aria-controls="catpanel">
        <Icon name="squares-four" />
        <span class="cat-label" id="cat-label">{t.catBtnAll}</span>
        <span class="cat-badge" id="cat-badge" hidden>0</span>
        <Icon name="caret-left" class="cat-chev" />
      </button>
    </div>
  </div>

  <div class="cat-backdrop" id="cat-backdrop" hidden></div>
  <div class="catpanel" id="catpanel" role="dialog" aria-label={t.catPanelAria} hidden>
    <div class="cp-head">
      <h3>{t.catPanelTitle}</h3>
      <button type="button" class="linkbtn" id="cat-done">{t.done}</button>
    </div>
    <div class="cp-body" id="chips">
      <div class="cp-toggles" role="group" aria-label={t.moreFilters}>
        <button type="button" class="chip skillchip" data-id="skill" style="--ci:0"><Icon name="sparkle" /><span class="cl">{t.onlySkills}</span><span class="n"></span></button>
        <button type="button" class="chip newchip" data-id="new" style="--ci:1"><Icon name="clock" /><span class="cl">{t.onlyNew}</span><span class="n"></span></button>
      </div>
      <div class="cp-grid" role="group" aria-label={t.catPanelTitle}>
        <button type="button" class="chip" data-id="all" style="--ci:2"><Icon name="squares-four" /><span class="cl">{t.allCats}</span><span class="n">{total}</span></button>
        {categories.map((c, i) => (
          <button type="button" class="chip" data-id={c.id} style={`--ci:${i + 3}`}><Icon name={categoryIcon(c.id)} /><span class="cl" set:html={txt(catName(c.id, lang), lang)} /><span class="n"></span></button>
        ))}
      </div>
    </div>
  </div>

  <section class="band alt build" aria-labelledby="build-h">
    <h2 class="sec-title" id="build-h" set:html={t.buildTitle_h} />
    <div class="projects" id="projects">
      {projects.map((p, i) => (
        <button type="button" class="ptile" data-p={p.id} aria-pressed="false" style={`--pi:${i}`}>
          <span class="pico"><Icon name={projectIcon(p.id)} weight="duotone" /></span>
          <span class="pl"><b set:html={txt(projName(p, lang), lang)} /><small>{t.nTools(p.count)}</small></span>
        </button>
      ))}
    </div>
    {projects.map((p) => (
      <div class="advice" data-advice={p.id} hidden>
        <h3 set:html={txt(projName(p, lang), lang)} />
        <p set:html={txt(projAdvice(p, lang), lang)} />
        <div class="picks">
          <span class="l">{t.startWith}</span>
          {p.picks.map((name, i) => (
            <button type="button" class="pickbtn" data-go={p.pickSlugs[i]}><bdi>{name}</bdi></button>
          ))}
        </div>
        <div class="advice-acts">
          {kitCount(p.pickSlugs) >= 2 && <button type="button" class="kit-btn" data-kit={p.pickSlugs.join(" ")} data-kit-title={t.kitFor(projName(p, lang))}><Icon name="terminal-window" />{t.kitPicksBtn}</button>}
          <button type="button" class="clear" data-clear="1">{t.showAll}</button>
        </div>
      </div>
    ))}
    <!-- «ساعدني أختار»: ثلاثة أسئلة ثم أنسب الأدوات (src/views/FinderFragment.astro) -->
    <div class="fd-cta">
      <Logo size={44} />
      <p class="fd-cta-t"><b>{t.fdCtaTitle}</b><span>{t.fdCtaSub}</span></p>
      <button type="button" class="btn-primary" data-finder aria-haspopup="dialog">{t.fdOpen}</button>
    </div>
  </section>

  <section class="band latest" aria-labelledby="latest-h">
    <h2 class="sec-title" id="latest-h" set:html={t.latestTitle_h} />
    <div class="latest-row">
      {latest.map((x) => (
        <a class="latest-item" href={href(lang, "tools/" + x.slug)}>
          <span class="li-new">{t.isNew}</span>
          <b class="li-name">{x.name}</b>
          <small class="li-cat" set:html={txt(catName(x.cat, lang), lang)} />
          <span class="li-foot">
            <span class="mono sm" aria-hidden="true">{initials(x.name)}</span>
            {x.stars && <span class="stars"><Icon name="star" weight="fill" />{x.stars}</span>}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- «الأكثر نسخًا هذا الأسبوع»: مخفي حتى يصل عدّاد النسخ (api/popular.js وsrc/scripts/popular.js) -->
  <section class="band popular" id="popular" aria-labelledby="popular-h" hidden>
    <h2 class="sec-title" id="popular-h" set:html={t.popularTitle_h} />
    <ol class="pop-list" id="pop-list"></ol>
  </section>

  <Newsletter lang={lang} />

  <main class="band alt" id="list">
    <div class="list-head">
      <h2 class="sec-title"><b class="ttl">{t.allTools}</b> <span id="flat-title" set:html={t.byStars_h} /><span class="n" id="flat-n">{total}</span></h2>
      <details class="legend-wrap">
        <summary><Icon name="info" />{t.legendSummary}</summary>
        <ul class="legend">
          {kinds.map(([k, icon, text]) => (
            <li><span class="kind"><Icon name={icon} /><bdi>{k}</bdi></span> <span set:html={text} /></li>
          ))}
          {([["مكتبة", t.legendLib], ["أداة", t.legendTool], ["موقع", t.legendSite]] as const).map(([k, text]) => (
            <li><span class="kind"><Icon name={kindIcon(k)} />{kindLabel(k, lang)}</span> {text}</li>
          ))}
          <li><span class="badge-new">{t.isNew}</span> {t.legendNew}</li>
          <li><span class="badge-pick">{t.pick}</span> {t.legendPick}</li>
          <li><span class="tag tag-warn">{t.legendWarnTag}</span> {t.legendWarn}</li>
          <li><span class="tag tag-bad">{t.legendBadTag}</span> {t.legendBad}</li>
        </ul>
      </details>
    </div>
    <div class="activebar" id="activebar" hidden>
      <span class="l"><Icon name="funnel" />{t.activeFilters}</span>
      <span class="afs" id="active-chips"></span>
      <button type="button" class="linkbtn" id="clear-all">{t.clearAll}</button>
      <button type="button" class="linkbtn share-view" data-share data-title={t.siteTitle}><Icon name="export" />{t.shareView}</button>
    </div>
    <div class="listinfo">
      <p class="status" id="status" aria-live="polite"></p>
      <p class="hiddenbar" id="hiddenbar" hidden><span id="hidden-n"></span> <button type="button" class="linkbtn" id="unhide">{t.unhide}</button></p>
      <label class="sortbox" for="sort">
        <span class="sl">{t.sortLabel}</span>
        <select id="sort">
          <option value="stars">{t.sortStars}</option>
          <option value="cat">{t.sortCat}</option>
          <option value="new">{t.sortNew}</option>
        </select>
      </label>
    </div>
    <section class="cat" id="by-stars" aria-labelledby="flat-title">
      <div class="grid" id="stars-grid">
        {byStars.slice(0, FIRST).map((x) => <Card tool={x} hideBtn rank={rankOf.get(x.slug)} lang={lang} />)}
      </div>
      <div class="more-wrap"><button type="button" class="btn-more" id="more" hidden>{t.showMore} <span id="more-n"></span></button></div>
      <noscript>
        <p class="nojs-cats">{t.noJsCats} {categories.map((c, i) => <>{i > 0 && " · "}<a href={href(lang, "category/" + c.id)} set:html={txt(catName(c.id, lang), lang)} /></>)}</p>
      </noscript>
    </section>
    {categories.map((c) => (
      <section class="cat" id={"cat-" + c.id} data-cat-section={c.id} hidden>
        <h2 class="cat-title"><span class="ct-ic"><Icon name={categoryIcon(c.id)} weight="duotone" /></span><a href={href(lang, "category/" + c.id)} set:html={txt(catName(c.id, lang), lang)} /><span class="n">{tools.filter((x) => x.cat === c.id).length}</span></h2>
        <div class="grid" data-grid={c.id}></div>
        <button type="button" class="sec-more" data-cat={c.id} hidden><span set:html={t.secMore_h} /><Icon name={fwd} /></button>
      </section>
    ))}
    <div class="empty" id="empty" hidden>
      <span class="empty-ic"><Icon name="magnifying-glass" weight="duotone" /></span>
      <p>{t.emptyTitle}</p>
      <p class="sug" id="empty-sug" hidden>{t.didYouMean} <button type="button" class="linkbtn" id="sug-btn" dir="auto"></button></p>
      <p class="sub">{t.emptySub}</p>
      <div class="empty-acts">
        <button type="button" class="btn-more" id="empty-wide" hidden></button>
        <button type="button" class="btn-primary" id="empty-reset">{t.clearAll}</button>
      </div>
      <p class="sg-row" id="empty-suggest-row" hidden><Icon name="lightbulb" />{t.sgEmpty} <button type="button" class="linkbtn" id="empty-suggest" data-suggest>{t.sgOpen}</button></p>
    </div>
  </main>

  <Fragment slot="footer">
    {t.homeFoot_h(formatDate(starsUpdatedAt, lang)).map((p) => <p set:html={p} />)}
  </Fragment>

  <CardIcons lang={lang} />
  <script type="application/json" id="app-data" set:html={JSON.stringify(appData)} />
</Base>

<script>
  import { initCopy } from "../scripts/copy.js";
  import { initFav } from "../scripts/fav.js";
  import { initDatesLater } from "../scripts/dates.js";
  import "../scripts/filter.js";
  import "../scripts/hero.js";
  import "../scripts/mascot.js";
  import "../scripts/popular.js";
  initCopy(document);
  initFav();
  initDatesLater();
</script>
