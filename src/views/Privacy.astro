---
// صفحة الخصوصية (/privacy/) بلغة معينة: ما يجمعه الموقع وما لا يجمعه، والناشر إن وُجد في data/meta.json.
// تُبنى من src/pages/privacy.astro ونظيريها في src/pages/de/ وsrc/pages/en/. النص في src/i18n/privacy.ts.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { operator, txt, formatDate } from "../lib/data";
import { type Lang } from "../i18n";
import { privacy, PRIVACY_UPDATED } from "../i18n/privacy";
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = privacy[lang];
if (!operator && lang === "ar") console.warn("تنبيه: لا مشغّل في data/meta.json (operator)، فصفحة الخصوصية بلا اسم المسؤول وعنوانه.");
---
<Base title={p.title} description={p.lead} path="/privacy" lang={lang}>
  <header class="top page-hero">
    <span class="cat-mark" aria-hidden="true"><Icon name="shield-check" weight="duotone" /></span>
    <h1>{p.title}</h1>
    <p class="lead">{p.lead}</p>
  </header>
  <section class="band alt" aria-label={p.title}>
    <div class="prose">
      {p.sections.map(([h, body]) => (
        <>
          <h2>{h}</h2>
          <p set:html={txt(body, lang)} />
        </>
      ))}
      <h2 id="imprint">{operator ? p.imprint : p.controller}</h2>
      {operator ? (
        <address>
          <bdi>{operator.name}</bdi>
          {operator.address.map((line) => <><br /><bdi>{line}</bdi></>)}
          {operator.email && <><br /><a href={"mailto:" + operator.email}><bdi>{operator.email}</bdi></a></>}
        </address>
      ) : (
        <p>{p.contactFallback}</p>
      )}
      <p class="updated">{p.updated(formatDate(PRIVACY_UPDATED, lang))}</p>
    </div>
  </section>
</Base>
