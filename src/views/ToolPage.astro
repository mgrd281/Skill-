---
// صفحة أداة واحدة بلغة معينة. تُبنى من src/pages/tools/[slug].astro وsrc/pages/de/tools/[slug].astro.
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import { type Tool, tools, projectById, txt, isLatin, formatDate, host, isAppStore, repoLabel, statusBadges, initials, kindIcon, kindLabel, categoryIcon, toolDesc, catName, projName } from "../lib/data";
import { type Lang, href, fwdIcon, t as dict } from "../i18n";
interface Props { tool: Tool; lang: Lang }
const { tool: x, lang } = Astro.props;
const t = dict(lang);
const fwd = fwdIcon(lang);
const desc = toolDesc(x, lang);
const kind = kindLabel(x.kind, lang);
const cat = catName(x.cat, lang);
const related = tools.filter((r) => r.cat === x.cat && r.slug !== x.slug)
  .sort((a, b) => b.starsN - a.starsN || a.order - b.order).slice(0, 3);
const badges = statusBadges(x, lang);
const warns = badges.filter((b) => b.kind !== "ok");
const plain = desc.length > 155 ? desc.slice(0, 152) + "..." : desc;
const date = formatDate(x.added.slice(0, 10), lang);
const license = x.license === "none" ? t.noLicense : x.license === "other" ? t.otherLicense : x.license;
const kindHtml = isLatin(kind) ? `<bdi>${kind}</bdi>` : kind;
// بيانات منظمة: مسار الصفحة (يظهر في نتائج Google) ووصف المشروع البرمجي
const abs = (p: string) => new URL(href(lang, p), Astro.site).href;
const jsonLd: object[] = [
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t.navTools, item: abs("") },
      { "@type": "ListItem", position: 2, name: cat, item: abs("#cat-" + x.cat) },
      { "@type": "ListItem", position: 3, name: x.name, item: abs("tools/" + x.slug) },
    ],
  },
];
if (x.gh) jsonLd.push({
  "@context": "https://schema.org", "@type": "SoftwareSourceCode", name: x.name, description: desc,
  codeRepository: x.gh, url: abs("tools/" + x.slug), inLanguage: lang,
  ...(x.license && !["none", "other"].includes(x.license) ? { license: `https://spdx.org/licenses/${x.license}.html` } : {}),
});
---
<Base title={t.toolTitle(x.name)} description={plain} path={`/tools/${x.slug}`} lang={lang} image={`og/${x.slug}.png`} imageAlt={x.name} jsonLd={jsonLd} expect="tool-icon">
  <article class="product">
    <header class="p-hero">
      <nav class="p-crumb" aria-label={t.crumbAria}>
        <a href={href(lang, "#list")}>{t.navTools}</a>
        <Icon name={fwd} />
        <a href={href(lang, "#cat-" + x.cat)}><Icon name={categoryIcon(x.cat)} /><span set:html={txt(cat, lang)} /></a>
      </nav>
      <span class="mono xl" id="tool-icon" aria-hidden="true">{initials(x.name)}</span>
      <h1>{x.name}</h1>
      <div class="p-badges">
        <span class="kind"><Icon name={kindIcon(x.kind)} /><Fragment set:html={kindHtml} /></span>
        {x.stars && <span class="stars"><Icon name="star" weight="fill" />{x.stars}</span>}
        {x.isNew && <span class="badge-new">{t.isNew}</span>}
        {badges.map((b) => <span class={b.kind === "ok" ? "tag" : `tag tag-${b.kind}`} title={b.title}>{b.text}{b.text && b.latin ? " " : ""}{b.latin && <bdi>{b.latin}</bdi>}</span>)}
      </div>
      <p class="p-sub" set:html={txt(desc, lang)} />
      <div class="p-cta">
        {x.gh ? (
          <a class="btn-primary" href={x.gh} target="_blank" rel="noopener noreferrer"><Icon name="github-logo" /><span set:html={t.openGitHub_h} /></a>
        ) : x.site ? (
          <a class="btn-primary" href={x.site} target="_blank" rel="noopener noreferrer"><Icon name="globe" />{isAppStore(x.site) ? t.openAppStore : t.visitSite}</a>
        ) : null}
        {x.gh && x.site && (
          <a class="link-more" href={x.site} target="_blank" rel="noopener noreferrer">{isAppStore(x.site) ? "App Store" : t.officialSite}<Icon name={fwd} /></a>
        )}
        <button type="button" class="fav favbtn-lg" data-fav={x.slug} data-name={x.name} aria-pressed="false">
          <Icon name="heart" class="h-off" /><Icon name="heart" weight="fill" class="h-on" />
          <span class="fav-label">{t.favAddTitle}</span>
        </button>
        <button type="button" class="sharebtn" data-share data-title={x.name} aria-label={t.shareAria(x.name)}>
          <Icon name="export" /><span>{t.share}</span>
        </button>
      </div>
      {warns.length > 0 && (
        <ul class="notice">
          {warns.map((b) => <li class={`n-${b.kind}`}><Icon name="warning" /><span>{b.title}</span></li>)}
        </ul>
      )}
    </header>

    <section class="band alt p-body">
      <div class="p-grid">
        {x.cmd && (
          <div class="p-tile p-install">
            <h2>{t.installTitle}</h2>
            <p class="p-note" set:html={t.installNote_h} />
            <div class="cmd">
              <pre tabindex="0" aria-label={t.cmdAria}><code>{x.cmd}</code></pre>
              <button type="button" class="copy" aria-label={t.copyAria}>
                <Icon name="copy" class="ic-copy" /><Icon name="check" weight="bold" class="ic-check" /><span class="copy-t">{t.copy}</span>
              </button>
            </div>
          </div>
        )}
        <div class="p-tile">
          <h2>{t.usefulForProjects}</h2>
          <div class="uses">
            {x.use.map((u) => <a class="usechip" href={href(lang, "#" + u)} set:html={txt(projName(projectById(u)!, lang), lang)} />)}
          </div>
        </div>
      </div>

      <div class="specs">
        <h2 class="sec-title">{t.specsTitle}</h2>
        <dl>
          <div><dt>{t.specKind}</dt><dd class="ic"><Icon name={kindIcon(x.kind)} /><Fragment set:html={kindHtml} /></dd></div>
          <div><dt>{t.specCat}</dt><dd class="ic"><Icon name={categoryIcon(x.cat)} /><span set:html={txt(cat, lang)} /></dd></div>
          {x.stars && <div><dt set:html={t.specStars_h} /><dd class="num">{x.stars}</dd></div>}
          {license && <div><dt>{t.specLicense}</dt><dd>{isLatin(license) ? <bdi>{license}</bdi> : license}</dd></div>}
          {x.gh && <div><dt>{t.specRepo}</dt><dd><a href={x.gh} target="_blank" rel="noopener noreferrer"><bdi>{repoLabel(x.gh)}</bdi></a></dd></div>}
          {x.site && <div><dt>{t.specSite}</dt><dd><a href={x.site} target="_blank" rel="noopener noreferrer"><bdi>{host(x.site)}</bdi></a></dd></div>}
          <div><dt>{t.specAdded}</dt><dd><time class="addedchip" datetime={x.added} data-added={x.added} title={t.addedOn + date}><span class="added-text">{date}</span></time></dd></div>
          {x.pushed && <div><dt>{t.specPushed}</dt><dd>{formatDate(x.pushed, lang)}</dd></div>}
        </dl>
      </div>
    </section>
  </article>

  {related.length > 0 && (
    <section class="band related">
      <h2 class="sec-title" set:html={t.relatedTitle_h} />
      <div class="grid">{related.map((r) => <Card tool={r} lang={lang} />)}</div>
    </section>
  )}

  <Fragment slot="footer">
    <p>{t.toolFoot}</p>
  </Fragment>
</Base>

<script>
  import { initCopy } from "../scripts/copy.js";
  import { initFav } from "../scripts/fav.js";
  import { initDates } from "../scripts/dates.js";
  initCopy(document);
  initFav();
  initDates();
</script>
