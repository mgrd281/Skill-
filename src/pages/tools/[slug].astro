---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import Icon from "../../components/Icon.astro";
import { tools, projectById, categoryById, rich, isLatin, formatDate, host, isAppStore, repoLabel, url, statusBadges, initials } from "../../lib/data";

export function getStaticPaths() {
  return tools.map((t) => ({ params: { slug: t.slug }, props: { tool: t } }));
}
const { tool: t } = Astro.props;
const cat = categoryById(t.cat);
const related = tools.filter((x) => x.cat === t.cat && x.slug !== t.slug)
  .sort((a, b) => b.starsN - a.starsN || a.order - b.order).slice(0, 3);
const badges = statusBadges(t);
const warns = badges.filter((b) => b.kind !== "ok");
const plain = t.desc.length > 155 ? t.desc.slice(0, 152) + "..." : t.desc;
const KIND: Record<string, string> = { Skill: "skill", MCP: "mcp", "مكتبة": "lib", "أداة": "tool", "موقع": "site", "منصة": "platform", "تطبيق": "app" };
const date = formatDate(t.added.slice(0, 10));
const license = t.license === "none" ? "بدون رخصة" : t.license === "other" ? "رخصة خاصة" : t.license;
---
<Base title={`${t.name} | دليل أدوات التصميم والتطوير`} description={plain} path={`/tools/${t.slug}`}>
  <article class="product">
    <header class="p-hero">
      <nav class="p-crumb" aria-label="مسار الصفحة">
        <a href={url("#list")}>الأدوات</a>
        <Icon name="chevron" />
        <a href={url("#cat-" + t.cat)} set:html={rich(cat.name)} />
      </nav>
      <span class="mono xl" aria-hidden="true">{initials(t.name)}</span>
      <h1>{t.name}</h1>
      <div class="p-badges">
        <span class="kind" data-k={KIND[t.kind] ?? "other"}>{isLatin(t.kind) ? <bdi>{t.kind}</bdi> : t.kind}</span>
        {t.stars && <span class="stars"><Icon name="star" filled />{t.stars}</span>}
        {t.isNew && <span class="badge-new">جديد</span>}
        {badges.map((b) => <span class={b.kind === "ok" ? "tag" : `tag tag-${b.kind}`} title={b.title}>{b.text}{b.text && b.latin ? " " : ""}{b.latin && <bdi>{b.latin}</bdi>}</span>)}
      </div>
      <p class="p-sub" set:html={rich(t.desc)} />
      <div class="p-cta">
        {t.gh ? (
          <a class="btn-primary" href={t.gh} target="_blank" rel="noopener noreferrer"><Icon name="github" />افتح على <bdi>GitHub</bdi></a>
        ) : t.site ? (
          <a class="btn-primary" href={t.site} target="_blank" rel="noopener noreferrer"><Icon name="globe" />{isAppStore(t.site) ? "افتح في App Store" : "زيارة الموقع"}</a>
        ) : null}
        {t.gh && t.site && (
          <a class="link-more" href={t.site} target="_blank" rel="noopener noreferrer">{isAppStore(t.site) ? "App Store" : "الموقع الرسمي"}<Icon name="chevron" /></a>
        )}
        <button type="button" class="fav favbtn-lg" data-fav={t.slug} data-name={t.name} aria-pressed="false">
          <Icon name="heart" />
          <span class="fav-label">أضف إلى المفضلة</span>
        </button>
      </div>
      {warns.length > 0 && (
        <ul class="notice">
          {warns.map((b) => <li class={`n-${b.kind}`}><Icon name="alert" /><span>{b.title}</span></li>)}
        </ul>
      )}
    </header>

    <section class="band alt p-body">
      <div class="p-grid">
        {t.cmd && (
          <div class="p-tile p-install">
            <h2>التثبيت</h2>
            <p class="p-note">انسخ الأمر والصقه في <bdi>Claude Code</bdi> أو في الطرفية داخل مجلد مشروعك.</p>
            <div class="cmd">
              <pre tabindex="0" aria-label="أمر التثبيت"><code>{t.cmd}</code></pre>
              <button type="button" class="copy" aria-label="نسخ أمر التثبيت">
                <Icon name="copy" class="ic-copy" /><Icon name="check" class="ic-check" /><span class="copy-t">نسخ</span>
              </button>
            </div>
          </div>
        )}
        <div class="p-tile">
          <h2>مفيد لمشاريع</h2>
          <div class="uses">
            {t.use.map((u) => <a class="usechip" href={url("#" + u)} set:html={rich(projectById(u)!.name)} />)}
          </div>
        </div>
      </div>

      <div class="specs">
        <h2 class="sec-title">المواصفات.</h2>
        <dl>
          <div><dt>النوع</dt><dd>{isLatin(t.kind) ? <bdi>{t.kind}</bdi> : t.kind}</dd></div>
          <div><dt>القسم</dt><dd set:html={rich(cat.name)} /></div>
          {t.stars && <div><dt>نجوم <bdi>GitHub</bdi></dt><dd class="num">{t.stars}</dd></div>}
          {license && <div><dt>الرخصة</dt><dd>{isLatin(license) ? <bdi>{license}</bdi> : license}</dd></div>}
          {t.gh && <div><dt>المستودع</dt><dd><a href={t.gh} target="_blank" rel="noopener noreferrer"><bdi>{repoLabel(t.gh)}</bdi></a></dd></div>}
          {t.site && <div><dt>الموقع</dt><dd><a href={t.site} target="_blank" rel="noopener noreferrer"><bdi>{host(t.site)}</bdi></a></dd></div>}
          <div><dt>أُضيفت إلى الدليل</dt><dd><time class="addedchip" datetime={t.added} data-added={t.added} title={"أُضيفت إلى الدليل: " + date}><span class="added-text">{date}</span></time></dd></div>
          {t.pushed && <div><dt>آخر تحديث للمستودع</dt><dd>{formatDate(t.pushed)}</dd></div>}
        </dl>
      </div>
    </section>
  </article>

  {related.length > 0 && (
    <section class="band related">
      <h2 class="sec-title">قد يعجبك أيضًا. <span>أدوات من القسم نفسه.</span></h2>
      <div class="grid">{related.map((r) => <Card tool={r} />)}</div>
    </section>
  )}

  <Fragment slot="footer">
    <p>المعلومات مأخوذة من صفحة المشروع الرسمية، وقد تتغير. تحقق من الرخصة وشروط الاستخدام قبل الاعتماد على أي أداة في عمل تجاري.</p>
  </Fragment>
</Base>

<script>
  import { initCopy } from "../../scripts/copy.js";
  import { initFav } from "../../scripts/fav.js";
  import { initDates } from "../../scripts/dates.js";
  initCopy(document);
  initFav();
  initDates();
</script>
