---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import HeartLink from "../components/HeartLink.astro";
import { tools, url } from "../lib/data";
---
<Base title="المفضلة | دليل أدوات التصميم والتطوير" description="الأدوات التي حفظتها في المفضلة." path="/favorites" noindex>
  <div class="crumbrow">
    <a class="crumb" href={url()}>← كل الأدوات</a>
    <HeartLink />
  </div>
  <header class="top">
    <h1>المفضلة</h1>
    <p class="lead" id="fav-lead">الأدوات التي ضغطت عليها بالقلب تظهر هنا. تُحفظ في متصفحك فقط على هذا الجهاز.</p>
  </header>

  <div class="favtools" hidden>
    <p class="status" id="fav-status" aria-live="polite"></p>
    <button type="button" class="linkbtn" id="fav-clear">مسح المفضلة كلها</button>
  </div>

  <main id="fav-main">
    <div class="grid" id="fav-grid"></div>
    <div class="favempty" id="fav-empty" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
      <p>لم تحفظ أي أداة بعد.</p>
      <p class="sub">اضغط على القلب في أي أداة لتجدها هنا لاحقًا.</p>
      <a class="btn site" href={url()}><span class="t"><b>تصفح الأدوات</b><small>&nbsp;</small></span></a>
    </div>
  </main>

  <!-- كل البطاقات هنا مخفية، والسكربت ينقل المفضلة منها إلى الشبكة أعلاه -->
  <div id="pool" hidden>
    {tools.map((t) => <Card tool={t} />)}
  </div>

  <Fragment slot="footer">
    <p>المفضلة محفوظة في هذا المتصفح فقط. إن مسحت بيانات الموقع أو غيّرت الجهاز فلن تجدها.</p>
  </Fragment>
</Base>

<script>
  import { initCopy } from "../scripts/copy.js";
  import { initFav, getFavs, onFavChange, clearFavs } from "../scripts/fav.js";

  const grid = document.getElementById("fav-grid");
  const pool = document.getElementById("pool");
  const empty = document.getElementById("fav-empty");
  const bar = document.querySelector(".favtools");
  const status = document.getElementById("fav-status");

  function render() {
    const favs = getFavs();
    const want = new Set(favs);
    // أعد البطاقات التي لم تعد مفضلة إلى المخزن
    [...grid.children].forEach((c) => { if (!want.has(c.dataset.slug)) pool.appendChild(c); });
    // رتّب المفضلة: الأحدث أولًا
    favs.forEach((slug) => {
      const card = document.getElementById("t-" + slug) || pool.querySelector('[data-slug="' + slug + '"]');
      if (card) grid.appendChild(card);
    });
    const n = grid.children.length;
    empty.hidden = n !== 0;
    bar.hidden = n === 0;
    status.textContent = "عدد الأدوات المحفوظة: " + n;
  }

  initCopy(document);
  initFav();
  render();
  onFavChange(render);
  document.getElementById("fav-clear").addEventListener("click", () => {
    if (confirm("هل تريد مسح كل المفضلة؟")) clearFavs();
  });
</script>
