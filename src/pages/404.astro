---
// صفحة واحدة لكل رابط غير موجود في اللغتين، لذلك تعرض الرسالة بالعربية ثم بالألمانية.
import Base from "../layouts/Base.astro";
import { categories, rich } from "../lib/data";
import { href } from "../i18n";
---
<Base title="الصفحة غير موجودة · Seite nicht gefunden" description="الصفحة التي طلبتها غير موجودة. Die angeforderte Seite existiert nicht." path="/404" switchPath="/" noindex>
  <header class="top page-hero">
    <h1>الصفحة غير موجودة</h1>
    <p class="lead">قد يكون الرابط قديمًا أو أُزيلت الأداة من الدليل. ابحث من الصفحة الرئيسية أو افتح أحد الأقسام.</p>
    <div class="cta"><a class="btn-primary" href={href("ar")}>العودة إلى كل الأدوات</a></div>
  </header>
  <section class="band nf-other" lang="de" dir="ltr" aria-labelledby="nf-de">
    <h2 class="sec-title" id="nf-de">Seite nicht gefunden. <span>Der Link ist veraltet oder das Tool wurde aus dem Verzeichnis entfernt.</span></h2>
    <a class="btn-primary" href={href("de")}>Zu allen Tools</a>
  </section>
  <section class="band alt" aria-labelledby="nf-h">
    <h2 class="sec-title" id="nf-h">الأقسام. <span>ابدأ من أحدها.</span></h2>
    <div class="chips wrapchips">
      {categories.map((c) => <a class="chip" href={href("ar", "#cat-" + c.id)}><span set:html={rich(c.name)} /></a>)}
    </div>
  </section>
</Base>
