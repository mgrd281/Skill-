---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import { tools, categories, projects, rich, starsUpdatedAt, formatDate, recentTools, categoryById, url, initials, kindIcon, categoryIcon, projectIcon } from "../lib/data";

const total = tools.length;
// الترتيب الافتراضي: الأعلى نجومًا أولًا (والتي بلا نجوم في النهاية)، ويُحسب وقت البناء فيتجدد مع تحديث النجوم الأسبوعي
const byStars = [...tools].sort((a, b) => b.starsN - a.starsN || a.order - b.order);
const rankOf = new Map<string, number>();
byStars.filter((t) => t.starsN >= 0).forEach((t, i) => rankOf.set(t.slug, i + 1));
const latest = recentTools.slice(0, 6);
const skillCount = tools.filter((t) => t.kind === "Skill").length;
const siteCount = tools.filter((t) => t.kind === "موقع").length;
const appData = {
  total,
  projects: projects.map((p) => ({ id: p.id, name: p.name, cats: p.cats ?? [], pickSlugs: p.pickSlugs })),
  cats: categories.map((c) => c.id),
  base: url("tools/"),
  feed: url("feed.xml"),
  recent: recentTools.map((r) => ({ slug: r.slug, name: r.name, added: r.added, cat: categoryById(r.cat).name })),
};
---
<Base
  title="دليل أدوات التصميم والتطوير"
  description={`أدوات تساعدك في عملك كل يوم، كلها في مكان واحد: ${total} أداة ومهارة لـ Claude وخوادم MCP ومكتبات للتصميم والتطوير والموشن غرافيك وiPhone وMac، ومواقع للكتابة والبرومبت، مع نجوم GitHub وأوامر التثبيت.`}
>
  <div class="notif-wrap" slot="nav-extra">
    <button type="button" id="bell" class="bell" aria-haspopup="dialog" aria-expanded="false" aria-controls="notif" aria-label="الإشعارات: أدوات جديدة">
      <Icon name="bell" />
      <span class="dot" id="bell-n" hidden>0</span>
    </button>
    <div class="notif" id="notif" role="dialog" aria-labelledby="nf-h" hidden>
      <div class="nf-head">
        <h3 id="nf-h">الإشعارات</h3>
        <button type="button" class="linkbtn" id="notif-read">تحديد الكل كمقروء</button>
      </div>
      <ul class="nf-list" id="notif-list"></ul>
      <div class="nf-empty" id="notif-empty">
        <span class="empty-ic"><Icon name="bell" weight="duotone" /></span>
        <p>لا جديد الآن</p>
      </div>
      <a class="nf-foot" href={url("feed.xml")}><Icon name="rss-simple" />اشترك في خلاصة <bdi>RSS</bdi><Icon name="caret-left" class="chev" /></a>
    </div>
  </div>

  <header class="hero">
    <div class="hero-text">
      <p class="eyebrow" style="--i:0">دليل الأدوات</p>
      <h1 style="--i:1">أدوات تساعدك في&nbsp;عملك، <span class="accent">كل يوم.</span></h1>
      <p class="lead" style="--i:2">
        <Fragment set:html={`مهارات <bdi>Claude</bdi> وخوادم <bdi>MCP</bdi> ومكتبات ومواقع مختارة بعناية، مرتبة بنجوم <bdi>GitHub</bdi>، مع أمر التثبيت لكل أداة.`} />
      </p>
      <div class="cta" style="--i:3">
        <button type="button" class="btn-primary" data-focus-search>ابحث عن أداة</button>
        <a class="link-more" href="#build-h">ماذا تبني؟<Icon name="caret-left" /></a>
      </div>
      <ul class="promise" style="--i:4">
        <li><Icon name="magnifying-glass" weight="duotone" />لا تحتاج أن تبحث</li>
        <li><Icon name="squares-four" weight="duotone" />كل شيء في مكان واحد</li>
        <li><Icon name="copy" weight="duotone" />أمر التثبيت جاهز</li>
      </ul>
    </div>

    <div class="showcase" aria-hidden="true">
      {byStars.slice(0, 3).map((t, i) => (
        <a class={`show-card s${i + 1}`} href={url("tools/" + t.slug)} tabindex="-1">
          <span class="mono">{initials(t.name)}</span>
          <span class="show-t">
            <b>{t.name}</b>
            <small set:html={rich(categoryById(t.cat).name)} />
          </span>
          {t.stars && <span class="stars"><Icon name="star" weight="fill" />{t.stars}</span>}
        </a>
      ))}
    </div>

    <dl class="stats">
      <div><dt>أداة مختارة</dt><dd>{total}</dd></div>
      <div><dt>مهارة <bdi>Skill</bdi></dt><dd>{skillCount}</dd></div>
      <div><dt>موقعًا للكتابة والبرومبت</dt><dd>{siteCount}</dd></div>
      <div><dt>قسمًا</dt><dd>{categories.length}</dd></div>
    </dl>
  </header>

  <div class="bar">
    <div class="bar-row">
      <div class="search">
        <Icon name="magnifying-glass" />
        <input id="q" type="search" placeholder="ابحث عن أداة" autocomplete="off" aria-label="بحث" enterkeyhint="search" />
        <button type="button" class="q-clear" id="q-clear" aria-label="مسح البحث" hidden><Icon name="x" weight="bold" /></button>
        <kbd class="q-kbd" aria-hidden="true">/</kbd>
      </div>
      <button type="button" class="cat-btn" id="cat-btn" aria-haspopup="dialog" aria-expanded="false" aria-controls="catpanel">
        <Icon name="squares-four" />
        <span class="cat-label" id="cat-label">كل الأقسام</span>
        <span class="cat-badge" id="cat-badge" hidden>0</span>
        <Icon name="caret-left" class="cat-chev" />
      </button>
    </div>
  </div>

  <div class="cat-backdrop" id="cat-backdrop" hidden></div>
  <div class="catpanel" id="catpanel" role="dialog" aria-label="اختر القسم" hidden>
    <div class="cp-head">
      <h3>الأقسام</h3>
      <button type="button" class="linkbtn" id="cat-done">تم</button>
    </div>
    <div class="cp-body" id="chips">
      <div class="cp-toggles" role="group" aria-label="تصفية إضافية">
        <button type="button" class="chip skillchip" data-id="skill"><Icon name="sparkle" /><span class="cl">المهارات فقط</span><span class="n"></span></button>
        <button type="button" class="chip newchip" data-id="new"><Icon name="clock" /><span class="cl">الجديد فقط</span><span class="n"></span></button>
      </div>
      <div class="cp-grid" role="group" aria-label="الأقسام">
        <button type="button" class="chip" data-id="all"><Icon name="squares-four" /><span class="cl">كل الأقسام</span><span class="n">{total}</span></button>
        {categories.map((c) => (
          <button type="button" class="chip" data-id={c.id}><Icon name={categoryIcon(c.id)} /><span class="cl" set:html={rich(c.name)} /><span class="n"></span></button>
        ))}
      </div>
    </div>
  </div>

  <section class="band alt build" aria-labelledby="build-h">
    <h2 class="sec-title" id="build-h">ماذا تبني؟ <span>اختر نوع مشروعك لترى ما يناسبه ونصيحة البداية.</span></h2>
    <div class="projects" id="projects">
      {projects.map((p) => (
        <button type="button" class="ptile" data-p={p.id} aria-pressed="false">
          <span class="pico"><Icon name={projectIcon(p.id)} weight="duotone" /></span>
          <span class="pl"><b set:html={rich(p.name)} /><small>{p.count} أداة</small></span>
        </button>
      ))}
    </div>
    {projects.map((p) => (
      <div class="advice" data-advice={p.id} hidden>
        <h3 set:html={rich(p.name)} />
        <p set:html={rich(p.advice)} />
        <div class="picks">
          <span class="l">ابدأ بهذه:</span>
          {p.picks.map((name, i) => (
            <button type="button" class="pickbtn" data-go={p.pickSlugs[i]}><bdi>{name}</bdi></button>
          ))}
        </div>
        <button type="button" class="clear" data-clear="1">عرض كل الأدوات</button>
      </div>
    ))}
  </section>

  <section class="band latest" aria-labelledby="latest-h">
    <h2 class="sec-title" id="latest-h">الأحدث. <span>آخر ما أضفناه إلى الدليل.</span></h2>
    <div class="latest-row">
      {latest.map((t) => (
        <a class="latest-item" href={url("tools/" + t.slug)}>
          <span class="li-new">جديد</span>
          <b class="li-name">{t.name}</b>
          <small class="li-cat" set:html={rich(categoryById(t.cat).name)} />
          <span class="li-foot">
            <span class="mono sm" aria-hidden="true">{initials(t.name)}</span>
            {t.stars && <span class="stars"><Icon name="star" weight="fill" />{t.stars}</span>}
          </span>
        </a>
      ))}
    </div>
  </section>

  <main class="band alt" id="list">
    <div class="list-head">
      <h2 class="sec-title"><b class="ttl">كل الأدوات.</b> <span id="flat-title">مرتبة حسب نجوم <bdi>GitHub</bdi>.</span><span class="n" id="flat-n">{total}</span></h2>
      <details class="legend-wrap">
        <summary><Icon name="info" />ما معنى الشارات؟</summary>
        <ul class="legend">
          <li><span class="kind"><Icon name="sparkle" /><bdi>Skill</bdi></span> تعليمات تضيفها إلى <bdi>Claude</bdi></li>
          <li><span class="kind"><Icon name="plug" /><bdi>MCP</bdi></span> يربط <bdi>Claude</bdi> بأداة خارجية</li>
          <li><span class="kind"><Icon name="package" />مكتبة</span> تُستخدم داخل كود الموقع</li>
          <li><span class="kind"><Icon name="wrench" />أداة</span> برنامج تشغّله على جهازك</li>
          <li><span class="kind"><Icon name="globe" />موقع</span> تستخدمه من المتصفح مباشرة</li>
          <li><span class="badge-new">جديد</span> أُضيفت خلال آخر 14 يومًا</li>
          <li><span class="badge-pick">ابدأ بها</span> أفضل بداية للمشروع المختار</li>
          <li><span class="tag tag-warn">تنبيه</span> مستودع قديم أو رخصة بشروط أو سكربت من الإنترنت</li>
          <li><span class="tag tag-bad">خطر</span> مؤرشف أو بلا رخصة</li>
        </ul>
      </details>
    </div>
    <div class="activebar" id="activebar" hidden>
      <span class="l"><Icon name="funnel" />فلاتر مفعّلة:</span>
      <span class="afs" id="active-chips"></span>
      <button type="button" class="linkbtn" id="clear-all">إزالة كل الفلاتر</button>
    </div>
    <div class="listinfo">
      <p class="status" id="status" aria-live="polite"></p>
      <p class="hiddenbar" id="hiddenbar" hidden><span id="hidden-n"></span> <button type="button" class="linkbtn" id="unhide">استعادة المخفية</button></p>
      <label class="sortbox" for="sort">
        <span class="sl">الترتيب:</span>
        <select id="sort">
          <option value="stars">الأعلى نجومًا</option>
          <option value="cat">حسب القسم</option>
          <option value="new">الأحدث إضافةً</option>
        </select>
      </label>
    </div>
    <section class="cat" id="by-stars" aria-labelledby="flat-title">
      <div class="grid" id="stars-grid">
        {byStars.map((t) => <Card tool={t} hideBtn rank={rankOf.get(t.slug)} />)}
      </div>
      <div class="more-wrap"><button type="button" class="btn-more" id="more" hidden>عرض المزيد <span id="more-n"></span></button></div>
    </section>
    {categories.map((c) => (
      <section class="cat" id={"cat-" + c.id} data-cat-section={c.id} hidden>
        <h2 class="cat-title"><span class="ct-ic"><Icon name={categoryIcon(c.id)} weight="duotone" /></span><span set:html={rich(c.name)} /><span class="n">{tools.filter((t) => t.cat === c.id).length}</span></h2>
        <div class="grid" data-grid={c.id}></div>
        <button type="button" class="sec-more" data-cat={c.id} hidden>عرض كل الـ <span class="sm-n"></span> في هذا القسم<Icon name="caret-left" /></button>
      </section>
    ))}
    <div class="empty" id="empty" hidden>
      <span class="empty-ic"><Icon name="magnifying-glass" weight="duotone" /></span>
      <p>لا توجد نتيجة مطابقة.</p>
      <p class="sub">جرّب كلمة أخرى، أو أزل الفلاتر لترى كل الأدوات.</p>
      <button type="button" class="btn-primary" id="empty-reset">إزالة كل الفلاتر</button>
    </div>
  </main>

  <Fragment slot="footer">
    <p>النجوم وروابط المواقع مأخوذة من صفحة كل مشروع على <bdi>GitHub</bdi>، وآخر تحديث لها بتاريخ {formatDate(starsUpdatedAt)}. مهارات <bdi>Anthropic</bdi> وإضافاتها، وكل مهارة داخل مستودع يضم عدة مهارات، تعرض نجوم ذلك المستودع كله.</p>
    <p>أوامر <bdi>/plugin</bdi> تُكتب داخل <bdi>Claude Code</bdi>. أوامر <bdi>npx</bdi> و<bdi>npm</bdi> و<bdi>flutter</bdi> و<bdi>docker</bdi> تُكتب في الطرفية داخل مجلد مشروعك.</p>
    <p>لاكتشاف مهارات أخرى: <bdi>skills.sh</bdi> يرتّبها حسب عدد التثبيت ويعرض فحصًا أمنيًا لكل مهارة، و<bdi>claudemarketplaces.com</bdi> يرتّبها حسب القسم. المهارة قد تشغّل أوامر على جهازك، فثبّت من مصادر معروفة فقط.</p>
    <p>رخص مجموعات الأيقونات والمكونات تختلف، وشعارات العلامات التجارية تبقى ملكًا لأصحابها. اقرأ الرخصة قبل الاستخدام التجاري.</p>
    <p>استثناءات: روابط <bdi>Remotion Skills</bdi> و<bdi>flutter_animate</bdi> و<bdi>Shopify Dev MCP</bdi> من التوثيق الرسمي، و<bdi>Aceternity UI</bdi> موقع فقط بدون مستودع.</p>
  </Fragment>

  <script type="application/json" id="app-data" set:html={JSON.stringify(appData)} />
</Base>

<script>
  import { initCopy } from "../scripts/copy.js";
  import { initFav } from "../scripts/fav.js";
  import { initDates } from "../scripts/dates.js";
  import "../scripts/filter.js";
  initCopy(document);
  initFav();
  initDates();
</script>
