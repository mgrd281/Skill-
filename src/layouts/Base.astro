---
// على أجهزة Apple يُستخدم خط النظام (SF Arabic وSF Pro)، وعلى غيرها IBM Plex Sans Arabic المستضاف محليًا.
import "@fontsource/ibm-plex-sans-arabic/arabic-400.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-500.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-600.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-700.css";
import "@fontsource/ibm-plex-sans-arabic/latin-400.css";
import "@fontsource/ibm-plex-sans-arabic/latin-500.css";
import "@fontsource/ibm-plex-sans-arabic/latin-600.css";
import "@fontsource/ibm-plex-sans-arabic/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import HeartLink from "../components/HeartLink.astro";
import IconSprite from "../components/IconSprite.astro";
import Feedback from "../components/Feedback.astro";
import { useIcon } from "../lib/icon-sprite";
import sansAr400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url";
import sansAr700 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-700-normal.woff2?url";
import sansLat400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-latin-400-normal.woff2?url";
import sansLat700 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-latin-700-normal.woff2?url";
import { type Lang, LANGS, DEFAULT_LANG, dirOf, LANG_NAME, OG_LOCALE, href, t as dict } from "../i18n";

// path: مسار الصفحة بدون بادئة اللغة ("/" أو "/tools/x"). كل صفحة موجودة بالعربية والألمانية.
// switchPath: وجهة زر اللغة إن اختلفت عن path (صفحة 404 تفتح الرئيسية باللغة الأخرى)
// image: صورة المشاركة (مسار داخل الموقع)، والافتراضي صورة الرئيسية بلغة الصفحة. jsonLd: بيانات منظمة لمحركات البحث
interface Props { title: string; description: string; path?: string; switchPath?: string; noindex?: boolean; lang?: Lang; image?: string; imageAlt?: string; jsonLd?: object[] }
const { title, description, path = "/", switchPath = path, noindex = false, lang = DEFAULT_LANG, image = `og/home-${lang}.png`, imageAlt = title, jsonLd = [] } = Astro.props;
const t = dict(lang);
const other: Lang = lang === "ar" ? "de" : "ar";
const abs = (l: Lang) => new URL(href(l, path), Astro.site).href;
const canonical = abs(lang);
const ogImage = new URL(href(DEFAULT_LANG, image), Astro.site).href;
// العربية تحتاج خطها العربي أولًا، والألمانية الحروف اللاتينية فقط
const preloads = lang === "ar" ? [sansAr400, sansAr700, sansLat400] : [sansLat400, sansLat700];
// يُرسم محتوى الصفحة أولًا حتى تُعرف كل أيقوناتها قبل رسم IconSprite،
// وتُسجَّل أيقونات الإطار (ThemeToggle وHeartLink وزر الأعلى) هنا لأنها تُرسم مع القالب.
const navExtra = await Astro.slots.render("nav-extra");
const main = await Astro.slots.render("default");
const footer = await Astro.slots.render("footer");
for (const n of ["moon", "sun", "heart", "arrow-up", "translate", "star"] as const) useIcon(Astro.locals, n);
// أيقونات نافذة الرأي (Feedback.astro) بأوزانها الخاصة
useIcon(Astro.locals, "star", "fill");
useIcon(Astro.locals, "x", "bold");
const icon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='9' fill='#2446D6'/><rect x='7' y='7' width='8' height='8' rx='2.4' fill='#fff'/><rect x='7' y='17' width='8' height='8' rx='2.4' fill='#fff' fill-opacity='.6'/><rect x='17' y='17' width='8' height='8' rx='2.4' fill='#fff'/><path d='M21 6.2Q21.6 10.4 25.8 11Q21.6 11.6 21 15.8Q20.4 11.6 16.2 11Q20.4 10.4 21 6.2Z' fill='#FFC94D'/></svg>`
  );
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>try{var t=localStorage.getItem("toolkit-theme");if(t==="dark"||t==="light")document.documentElement.dataset.theme=t}catch(e){}</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(DEFAULT_LANG)} />}
    <link rel="icon" href={icon} />
    <link rel="apple-touch-icon" href={href(DEFAULT_LANG, "apple-touch-icon.png")} />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title={t.rssTitle} href={new URL(href(lang, "feed.xml"), Astro.site).href} />
    {preloads.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="gnav">
      <div class="gnav-in">
        <a class="brand" href={href(lang)} aria-label={t.homeAria}>
          <Logo size={28} />
          <span>{t.siteName}</span>
        </a>
        <nav class="gnav-links" aria-label={t.navAria}>
          <a href={href(lang, "#list")}>{t.navTools}</a>
          <a href={href(lang, "#build-h")}>{t.navBuild}</a>
          <a href={href(lang, "#latest-h")}>{t.navLatest}</a>
          <a href={href(lang, "favorites")}>{t.navFavs}</a>
        </nav>
        <div class="actions">
          <a class="bell langsw" href={href(other, switchPath)} hreflang={other} aria-label={t.langSwitchAria} title={LANG_NAME[other]}>
            <Icon name="translate" /><span class="ls-t" lang={other}>{LANG_NAME[other]}</span>
          </a>
          <Fragment set:html={navExtra} />
          <ThemeToggle lang={lang} />
          <HeartLink lang={lang} />
        </div>
      </div>
    </header>

    <div class="wrap" id="main">
      <Fragment set:html={main} />
    </div>

    <footer class="foot">
      <div class="foot-in">
        <div class="foot-notes">
          <Fragment set:html={footer} />
        </div>
        <div class="foot-bottom">
          <a class="brand sm" href={href(lang)}><Logo size={22} /><span>{t.siteName}</span></a>
          <nav class="foot-nav" aria-label={t.footNavAria}>
            <a href={href(lang)}>{t.home}</a>
            <a href={href(lang, "favorites")}>{t.navFavs}</a>
            <a href={href(lang, "feed.xml")}><bdi>RSS</bdi></a>
            <button type="button" data-feedback>{t.fbOpen}</button>
          </nav>
          <nav class="foot-lang" aria-label={t.footLangAria}>
            {LANGS.map((l) => l === lang
              ? <span aria-current="true" lang={l}>{LANG_NAME[l]}</span>
              : <a href={href(l, switchPath)} hreflang={l} lang={l}>{LANG_NAME[l]}</a>)}
          </nav>
          <p class="foot-copy" set:html={t.footCopy_h} />
        </div>
      </div>
    </footer>

    <button type="button" class="totop" id="totop" aria-label={t.toTop} title={t.toTop}><Icon name="arrow-up" /></button>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <Feedback lang={lang} />
    <IconSprite />
  </body>
</html>

<script>
  import "../scripts/ui.js";
  import "../scripts/feedback.js";
</script>
