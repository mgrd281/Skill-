---
// على أجهزة Apple يُستخدم خط النظام (SF Arabic وSF Pro)، وعلى غيرها IBM Plex Sans Arabic المستضاف محليًا.
import "@fontsource/ibm-plex-sans-arabic/arabic-400.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-500.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-600.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-700.css";
import "@fontsource/ibm-plex-sans-arabic/latin-400.css";
import "@fontsource/ibm-plex-sans-arabic/latin-500.css";
import "@fontsource/ibm-plex-sans-arabic/latin-600.css";
import "@fontsource/ibm-plex-sans-arabic/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import HeartLink from "../components/HeartLink.astro";
import IconSprite from "../components/IconSprite.astro";
import Feedback from "../components/Feedback.astro";
import SuggestDialog from "../components/SuggestDialog.astro";
import KitDialog from "../components/KitDialog.astro";
import QuickSearch from "../components/QuickSearch.astro";
import { useIcon } from "../lib/icon-sprite";
import sansAr400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url";
import sansAr700 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-700-normal.woff2?url";
import sansLat400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-latin-400-normal.woff2?url";
import sansLat700 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-latin-700-normal.woff2?url";
import { type Lang, LANGS, DEFAULT_LANG, dirOf, LANG_NAME, OG_LOCALE, href, fwdIcon, t as dict } from "../i18n";
import { tools, categories, catName, txt } from "../lib/data";

// path: مسار الصفحة بدون بادئة اللغة ("/" أو "/tools/x"). كل صفحة موجودة بالعربية والألمانية.
// switchPath: وجهة زر اللغة إن اختلفت عن path (صفحة 404 تفتح الرئيسية باللغة الأخرى)
// image: صورة المشاركة (مسار داخل الموقع)، والافتراضي صورة الرئيسية بلغة الصفحة. jsonLd: بيانات منظمة لمحركات البحث
// expect: معرّف عنصر يُنتظر قبل أول رسم للصفحة، حتى يجده الانتقال بين الصفحات (أيقونة صفحة الأداة)
// quickSearch: زر البحث السريع في الشريط العلوي ونافذته (الصفحة الرئيسية لها بحثها فلا تحتاجه)
interface Props { title: string; description: string; path?: string; switchPath?: string; noindex?: boolean; lang?: Lang; image?: string; imageAlt?: string; jsonLd?: object[]; expect?: string; quickSearch?: boolean }
const { title, description, path = "/", switchPath = path, noindex = false, lang = DEFAULT_LANG, image = `og/home-${lang}.png`, imageAlt = title, jsonLd = [], expect, quickSearch = true } = Astro.props;
const t = dict(lang);
// التذييل: أكثر ستة أقسام أدواتٍ، وسنة البناء للحقوق
const topCats = categories.map((c) => c.id).sort((a, b) => tools.filter((x) => x.cat === b).length - tools.filter((x) => x.cat === a).length).slice(0, 6);
const year = new Date().getFullYear();
const others = LANGS.filter((l) => l !== lang);
const abs = (l: Lang) => new URL(href(l, path), Astro.site).href;
const canonical = abs(lang);
const ogImage = new URL(href(DEFAULT_LANG, image), Astro.site).href;
// العربية تحتاج خطها العربي أولًا، والألمانية الحروف اللاتينية فقط
const preloads = lang === "ar" ? [sansAr400, sansAr700, sansLat400] : [sansLat400, sansLat700];
// يُرسم محتوى الصفحة أولًا حتى تُعرف كل أيقوناتها قبل رسم IconSprite،
// وتُسجَّل أيقونات الإطار (ThemeToggle وHeartLink وزر الأعلى) هنا لأنها تُرسم مع القالب.
const navExtra = await Astro.slots.render("nav-extra");
const main = await Astro.slots.render("default");
const footer = await Astro.slots.render("footer");
for (const n of ["moon", "sun", "heart", "arrow-up", "translate", "star", "caret-left"] as const) useIcon(Astro.locals, n);
// أيقونات نافذة الرأي (Feedback.astro) بأوزانها الخاصة
useIcon(Astro.locals, "star", "fill");
useIcon(Astro.locals, "x", "bold");
// علامة اللغة الحالية في قائمة اللغات
useIcon(Astro.locals, "check", "bold");
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- الانتقال بين الصفحات (تفاصيله في global.css، قسم "الانتقال بين الصفحات"). التفعيل هنا لا في ملف CSS:
         Chromium يقرأه لحظة ظهور الصفحة الجديدة، وقد يسبق ذلك تطبيق ملف CSS الخارجي فيُلغى الانتقال. -->
    <style is:inline>@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }</style>
    <script is:inline>document.documentElement.classList.add("js");try{var t=localStorage.getItem("toolkit-theme");if(t==="dark"||t==="light")document.documentElement.dataset.theme=t}catch(e){}addEventListener("pagereveal",function(e){var v=e.viewTransition;if(v){document.documentElement.classList.add("vt-in");v.ready.catch(function(){})}})</script>
    {expect && <link rel="expect" href={"#" + expect} blocking="render" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(DEFAULT_LANG)} />}
    <!-- الأيقونات: SVG للمتصفحات الحديثة، وICO (16/32/48) لغيرها ولمحركات البحث التي تطلب /favicon.ico، وPNG لـ iOS. تُولَّد بـ npm run brand -->
    <link rel="icon" href={href(DEFAULT_LANG, "favicon.ico")} sizes="48x48" />
    <link rel="icon" href={href(DEFAULT_LANG, "favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href(DEFAULT_LANG, "apple-touch-icon.png")} />
    <link rel="manifest" href={href(lang, "manifest.webmanifest")} />
    <meta name="application-name" content={t.siteName} />
    <meta name="apple-mobile-web-app-title" content={t.siteName} />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title={t.rssTitle} href={new URL(href(lang, "feed.xml"), Astro.site).href} />
    {preloads.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {others.map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="gnav">
      <div class="gnav-in">
        <a class="brand" href={href(lang)} aria-label={t.homeAria}>
          <Logo size={28} />
          <span>{t.siteName}</span>
        </a>
        <nav class="gnav-links" aria-label={t.navAria}>
          <a href={href(lang, "#list")}>{t.navTools}</a>
          <a href={href(lang, "#build-h")}>{t.navBuild}</a>
          <a href={href(lang, "#latest-h")}>{t.navLatest}</a>
          <a href={href(lang, "favorites")}>{t.navFavs}</a>
          <a href={href(lang, "compare/")}>{t.navCompare}</a>
        </nav>
        <div class="actions">
          {quickSearch && (
            <button type="button" class="bell" id="qs-open" aria-haspopup="dialog" aria-expanded="false" aria-controls="qs" aria-keyshortcuts="Control+K Meta+K /" aria-label={t.qsOpen} title={t.qsOpen}>
              <Icon name="magnifying-glass" />
            </button>
          )}
          <!-- قائمة اللغة (تعمل بلا JavaScript؛ ui.js يضيف الإغلاق بالنقر خارجها وبـ Escape). روابط اللغات أيضًا في التذييل -->
          <details class="langmenu" id="langmenu">
            <summary class="bell langsw" title={t.langMenuAria}>
              <Icon name="translate" />
              <span class="sr">{t.langMenuAria}: <span lang={lang}>{LANG_NAME[lang]}</span></span>
              <span class="ls-t" lang={lang} aria-hidden="true">{LANG_NAME[lang]}</span>
              <Icon name="caret-left" class="ls-chev" />
            </summary>
            <ul class="lang-list">
              {LANGS.map((l) => (
                <li>
                  {l === lang
                    ? <span class="lang-item" aria-current="true" lang={l}>{LANG_NAME[l]}<Icon name="check" weight="bold" /></span>
                    : <a class="lang-item" href={href(l, switchPath)} hreflang={l} lang={l}>{LANG_NAME[l]}</a>}
                </li>
              ))}
            </ul>
          </details>
          <Fragment set:html={navExtra} />
          <ThemeToggle lang={lang} />
          <HeartLink lang={lang} />
        </div>
      </div>
    </header>

    <div class="wrap" id="main">
      <Fragment set:html={main} />
    </div>

    <!-- التذييل: ملاحظات الصفحة (إن وُجدت)، ثم الشعار ووصف الدليل وأعمدة الروابط (أكورديون على الجوال: ui.js)،
         ثم شريط الحقوق واللغات، ثم اسم الدليل كبيرًا خافتًا (زينة: aria-hidden، ونصه من CSS فلا تقرؤه قارئات الشاشة) -->
    <footer class="foot">
      <div class="foot-in">
        <div class="foot-notes">
          <Fragment set:html={footer} />
        </div>
        <div class="foot-main">
          <div class="foot-brand">
            <a class="foot-logo" href={href(lang)}><Logo size={34} /><span>{t.siteName}</span></a>
            <p class="foot-tag" set:html={txt(t.footTag, lang)} />
            <p class="foot-stats">{t.footStats(tools.length, categories.length)}</p>
            <button type="button" class="foot-cta" data-finder aria-haspopup="dialog">{t.fdOpen}<Icon name={fwdIcon(lang)} /></button>
          </div>
          <nav class="foot-cols" aria-label={t.footNavAria}>
            <details class="foot-col" open>
              <summary class="foot-h">{t.footColDir}<Icon name="caret-down" class="foot-chev" /></summary>
              <ul>
                <li><a href={href(lang, "#list")}>{t.footAll}</a></li>
                <li><a href={href(lang, "#latest-h")}>{t.navLatest}</a></li>
                <li><a href={href(lang, "#build-h")}>{t.navBuild}</a></li>
                <li><a href={href(lang, "compare/")}>{t.navCompare}</a></li>
                <li><a href={href(lang, "favorites")}>{t.navFavs}</a></li>
              </ul>
            </details>
            <details class="foot-col" open>
              <summary class="foot-h">{t.footColCats}<Icon name="caret-down" class="foot-chev" /></summary>
              <ul>
                {topCats.map((c) => <li><a href={href(lang, "category/" + c)} set:html={txt(catName(c, lang), lang)} /></li>)}
              </ul>
            </details>
            <details class="foot-col" open>
              <summary class="foot-h">{t.footColJoin}<Icon name="caret-down" class="foot-chev" /></summary>
              <ul>
                <li><button type="button" data-feedback>{t.fbOpen}</button></li>
                <li><button type="button" data-suggest>{t.sgOpen}</button></li>
                <li><a href={href(lang, "feed.xml")}>{t.footRss}</a></li>
              </ul>
            </details>
          </nav>
        </div>
        <div class="foot-bar">
          <p class="foot-copy"><span>{t.footRights(year)}</span> <span set:html={t.footCopy_h} /></p>
          <a class="foot-legal" href={href(lang, "privacy/")}>{t.privacyLink}</a>
          <nav class="foot-lang" aria-label={t.footLangAria}>
            {LANGS.map((l) => l === lang
              ? <span aria-current="true" lang={l}>{LANG_NAME[l]}</span>
              : <a href={href(l, switchPath)} hreflang={l} lang={l}>{LANG_NAME[l]}</a>)}
          </nav>
        </div>
      </div>
      <div class="foot-mark" aria-hidden="true" data-mark={t.siteName} style={`--chars:${[...t.siteName].length}`}></div>
    </footer>

    <button type="button" class="totop" id="totop" aria-label={t.toTop} title={t.toTop}><Icon name="arrow-up" /></button>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <Feedback lang={lang} />
    <SuggestDialog lang={lang} />
    <!-- حزمة التثبيت في كل صفحة: تفتحها أزرار [data-kit] في الرئيسية والمفضلة والمقارنة ونتائج «ساعدني أختار» -->
    <KitDialog lang={lang} />
    {quickSearch && <QuickSearch lang={lang} />}
    <IconSprite />
  </body>
</html>

<script>
  import "../scripts/ui.js";
  import "../scripts/feedback.js";
  import "../scripts/suggest.js";
  import "../scripts/finder.js";
  import "../scripts/analytics.js";
  import "../scripts/page-transition.js";
</script>
