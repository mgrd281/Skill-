---
import "@fontsource/ibm-plex-sans-arabic/arabic-400.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-500.css";
import "@fontsource/ibm-plex-sans-arabic/arabic-600.css";
import "@fontsource/ibm-plex-sans-arabic/latin-400.css";
import "@fontsource/ibm-plex-sans-arabic/latin-500.css";
import "@fontsource/ibm-plex-sans-arabic/latin-600.css";
import "@fontsource/noto-kufi-arabic/arabic-600.css";
import "@fontsource/noto-kufi-arabic/arabic-700.css";
import "@fontsource/noto-kufi-arabic/latin-600.css";
import "@fontsource/noto-kufi-arabic/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/global.css";
import { url } from "../lib/data";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import sansAr400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url";
import sansAr600 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-600-normal.woff2?url";
import kufiAr700 from "@fontsource/noto-kufi-arabic/files/noto-kufi-arabic-arabic-700-normal.woff2?url";
import kufiAr600 from "@fontsource/noto-kufi-arabic/files/noto-kufi-arabic-arabic-600-normal.woff2?url";
import sansLat400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-latin-400-normal.woff2?url";

interface Props { title: string; description: string; path?: string; noindex?: boolean }
const { title, description, path = "/", noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const icon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='9' fill='#2446D6'/><rect x='7' y='7' width='8' height='8' rx='2.4' fill='#fff'/><rect x='7' y='17' width='8' height='8' rx='2.4' fill='#fff' fill-opacity='.6'/><rect x='17' y='17' width='8' height='8' rx='2.4' fill='#fff'/><path d='M21 6.2Q21.6 10.4 25.8 11Q21.6 11.6 21 15.8Q20.4 11.6 16.2 11Q20.4 10.4 21 6.2Z' fill='#FFC94D'/></svg>`
  );
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>try{var t=localStorage.getItem("toolkit-theme");if(t==="dark"||t==="light")document.documentElement.dataset.theme=t}catch(e){}</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={icon} />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <meta name="theme-color" content="#F6F7FA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0F15" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title="أحدث الأدوات المضافة" href={new URL("feed.xml", Astro.site).href} />
    {[sansAr400, sansAr600, kufiAr700, kufiAr600, sansLat400].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="wrap" dir="rtl" lang="ar">
      <slot />
      <footer class="foot">
        <div class="foot-top">
          <a class="brand" href={url()}>
            <Logo />
            <span>دليل الأدوات</span>
          </a>
          <nav class="foot-nav" aria-label="روابط الموقع">
            <a href={url()}><Icon name="home" />الرئيسية</a>
            <a href={url("favorites")}><Icon name="heart" />المفضلة</a>
            <a href={url("feed.xml")}><Icon name="rss" /><bdi>RSS</bdi></a>
          </nav>
        </div>
        <div class="foot-notes">
          <slot name="footer" />
        </div>
      </footer>
    </div>
    <button type="button" class="totop" id="totop" aria-label="العودة إلى الأعلى" title="العودة إلى الأعلى"><Icon name="arrow-up" /></button>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>

<script>
  import "../scripts/ui.js";
</script>
